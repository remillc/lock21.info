{
  "name": "lock21.info",
  "version": "0.10.0",
  "description": "lock21.info: field notebook and 3D model of the submerged Lock 21 (Astro + Starlight)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "model:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/publish-model/publish_zones.ps1 -Changed -DryRun",
    "model:post-modified": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/publish-model/publish_zones.ps1 -Changed",
    "model:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/publish-model/publish_zones.ps1",
    "model:serve-tiles": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/publish-model/serve-tiles.ps1",
    "viewer:dev": "npm --prefix viewer run dev",
    "viewer:build": "npm --prefix viewer run build",
    "model:upload": "node tools/publish-model/upload_r2.mjs",
    "downloads:upload": "node tools/publish-model/upload_downloads.mjs",
    "build:viewer": "npm --prefix viewer run build -- --outDir ../public/modele/viewer --emptyOutDir",
    "preview": "astro preview",
    "i18n:status": "node tools/i18n/status.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.4.1",
    "qrcode": "^1.5.4",
    "sass": "^1.105.2"
  },
  "engines": {
    "node": ">=18.0"
  },
  "type": "module",
  "devDependencies": {
    "wrangler": "4.151.3"
  }
}
