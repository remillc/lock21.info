# Production build (npm run build, deployment): the 3D viewer's tiles (src/viewer/main.js) served by Cloudflare R2.
# Local development (npm run dev) keeps the default http://localhost:8081 (npm run model:serve-tiles:
# tools/publish-model/serve-tiles.ps1). PUBLIC_: the prefix Astro passes on to the browser's code.
PUBLIC_TILES_URL=https://tiles.lock21.info
