# Cache headers for Cloudflare (Workers static assets read this file from the built site's root).
# Astro's built files (the 3D viewer's included) carry a hash of their content in their name: cached for a year,
# never stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The web app (TODO #81): the service worker always checked for a new version (the browser also caps its own cache of
# it at a day); the manifests and icons a day
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json
/manifest-en.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json
/icons/*
  Cache-Control: public, max-age=86400
