// Cloudflare hosting of lock21.info (Workers static assets, custom domain lock21.info): the built site (dist/, from
// npm run build) served as is.
// Deployed by .github/workflows/deploy.yml with Wrangler (on a version tag or a manual run), never on a push.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lock21-info",
  "compatibility_date": "2026-10-01",
  // A small script only for the English home page (/en/) and the viewer's telemetry (/api/log): worker/index.js;
  // every other address is a static file
  "main": "worker/index.js",
  "assets": {
    "binding": "ASSETS",
    // /*/: the addresses with a final slash, redirected for good to the page's address (worker/index.js)
    "run_worker_first": ["/en", "/en/", "/api/*", "/*/"],
    "directory": "./dist",
    // Addresses without a final slash (astro.config.mjs, trailingSlash): <path>/index.html is served at <path>, and
    // <path>/ redirects there
    "html_handling": "drop-trailing-slash",
    // unknown addresses get the nearest 404.html, with a 404 status: en/404.html under /en/, 404.html elsewhere
    // (src/pages/404.astro, src/pages/en/404.astro)
    "not_found_handling": "404-page"
  },
  // Preview deployments of branches (manual runs on a branch other than main) get their own address
  "preview_urls": true,
  // No lock21-info.lock21.workers.dev: the site at one address only (SEO audit S11, docs/audits/seo-2026-10-26.md);
  // the previews keep theirs (preview_urls). If a preview stops working after a deploy, set it back to true
  "workers_dev": false,
  // Workers Logs: the telemetry messages (and the script's errors), kept a few days, searchable in the dashboard
  "observability": { "enabled": true }
}
