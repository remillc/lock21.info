---
// <l21-viewer-warmup>: when a link to /modele (or /en/modele) is hovered, focused or touched, the browser fetches the 3D viewer's
// heavy files in the background (<link rel="prefetch">: about 3 MB, JavaScript bundle, sky HDR, KTX2 transcoder), so
// that the viewer starts at once on /modele. Astro's own prefetch (ClientRouter) only fetches the page's HTML, not
// what its iframe loads. Once per visit; not on /modele itself, nor with data saver or a 2G connection.
// The bundle's file names change with each build: read here from the built viewer (public/modele/viewer/index.html,
// npm run build:viewer, run before the site's build). Nothing in development, where the viewer is its own dev server.
import fs from 'node:fs'
import path from 'node:path'

const base = '/modele/viewer/'
/** @type {string[]} */
let files = []
if (import.meta.env.PROD) {
  try {
    const html = fs.readFileSync(path.join(process.cwd(), 'public', 'modele', 'viewer', 'index.html'), 'utf-8')
    const built = [...html.matchAll(/<(?:script|link)[^>]+(?:src|href)="(\/modele\/viewer\/assets\/[^"]+\.(?:js|css))"/g)].map((m) => m[1])
    files = [...built, `${base}hdri/sky.hdr`, `${base}vendor/basis/basis_transcoder.js`, `${base}vendor/basis/basis_transcoder.wasm`]
  } catch {
    // Viewer not built: no warm-up
  }
}
---

{files.length > 0 && <l21-viewer-warmup data-files={JSON.stringify(files)} hidden />}

<script>
  class ViewerWarmup extends HTMLElement {
    /** @param {Event} event */
    onIntent = (event) => {
      const link = /** @type {HTMLAnchorElement | undefined} */ (/** @type {Element | null} */ (event.target)?.closest?.('a[href]'))
      /** @param {string} path */
      const toModel = (path) => /^(\/en)?\/modele$/.test(path)
      if (!link || !toModel(new URL(link.href).pathname) || /** @type {any} */ (window).lock21ViewerWarm || toModel(location.pathname)) return
      const connection = /** @type {any} */ (navigator).connection
      if (connection?.saveData || /2g/.test(connection?.effectiveType ?? '')) return
      ;/** @type {any} */ (window).lock21ViewerWarm = true
      for (const href of /** @type {string[]} */ (JSON.parse(this.dataset.files ?? '[]'))) {
        const prefetch = document.createElement('link')
        prefetch.rel = 'prefetch'
        prefetch.href = href
        // Same request mode (CORS) as the viewer's own requests (<script type="module" crossorigin>, fetch() for the sky
        // and the transcoder): with another mode, the browser doesn't reuse the prefetched copy
        prefetch.crossOrigin = 'anonymous'
        document.head.append(prefetch)
      }
    }

    connectedCallback() {
      for (const type of ['pointerover', 'focusin', 'touchstart']) document.addEventListener(type, this.onIntent, { passive: true })
    }

    // The header is replaced on each client-side navigation: the old element stops listening
    disconnectedCallback() {
      for (const type of ['pointerover', 'focusin', 'touchstart']) document.removeEventListener(type, this.onIntent)
    }
  }
  customElements.define('l21-viewer-warmup', ViewerWarmup)
</script>
