---
import { Icon } from 'astro-icon/components'
// The "Modèle 3D" pill (MD3 tertiary, the signal colour): in the header on wide screens (HeaderActions.astro), at the
// top of the mobile menu on small ones (Sidebar.astro). The /modele/ page is prefetched as soon as the pill is on
// screen (Astro prefetch, "viewport").
import { site } from '../data/site'
import { localPath, pageLang } from '../lib/i18n'
import { m } from '../paraglide/messages.js'

const lang = pageLang(Astro.locals)
---

<a href={localPath(site.viewer, lang)} class="model-pill" data-astro-prefetch="viewport">
  <!-- The navigation's « Modèle 3D » cube (custom.scss), in the pill's text colour: Material Symbols Rounded by name
       (astro-icon, astro.config.mjs) -->
  <Icon name="material-symbols:deployed-code-outline-rounded" aria-hidden="true" width="18" height="18" />
  {m.pill_model({}, { locale: lang })}
</a>

<style>
  @layer l21.components {
    /* MD3 filled button: 40 px high in a 48 px touch target (the transparent border, its colour inside it; TODO #59).
       Plain CSS, nested (Christian, 2026-10-26) */
    .model-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-sizing: border-box;
      min-height: 48px;
      padding: 0 1rem;
      border: 4px solid transparent;
      border-radius: var(--md-sys-shape-full);
      background: var(--md-sys-color-tertiary);
      background-clip: padding-box;
      color: var(--md-sys-color-on-tertiary);
      font-family: var(--l21-font-data);
      font-size: 0.875rem;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;

      &:hover {
        box-shadow: inset 0 0 0 100px color-mix(in srgb, var(--md-sys-color-on-tertiary) var(--md-sys-state-hover), transparent);
      }

      &:focus-visible,
      &:active {
        box-shadow: inset 0 0 0 100px color-mix(in srgb, var(--md-sys-color-on-tertiary) var(--md-sys-state-pressed), transparent);
      }

      &:focus-visible {
        outline: 2px solid var(--md-sys-color-secondary);
        outline-offset: -2px;
      }
    }
  }
</style>
