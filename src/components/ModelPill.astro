---
// The "Modèle 3D" pill (MD3 tertiary, the signal colour): in the header on wide screens (HeaderActions.astro), at the
// top of the mobile menu on small ones (Sidebar.astro). The /modele/ page is prefetched as soon as the pill is on
// screen (Astro prefetch, "viewport").
import { site } from '../data/site'
import { localPath, pageLang } from '../lib/i18n'

const lang = pageLang(Astro.locals)
const english = lang === 'en'
---

<a href={localPath(site.viewer, lang)} class="model-pill" data-astro-prefetch="viewport">
  <!-- The navigation's « Modèle 3D » cube (custom.scss), in the pill's text colour: Material Symbols Rounded
       « deployed_code » (TODO #74; was a drawing of its own) -->
  <svg aria-hidden="true" width="18" height="18" viewBox="0 -960 960 960" fill="currentColor"><path d="M440-183v-274L200-596v274l240 139Zm80 0 240-139v-274L520-457v274Zm-40-343 237-137-237-137-237 137 237 137ZM160-252q-19-11-29.5-29T120-321v-318q0-22 10.5-40t29.5-29l280-161q19-11 40-11t40 11l280 161q19 11 29.5 29t10.5 40v318q0 22-10.5 40T800-252L520-91q-19 11-40 11t-40-11L160-252Zm320-228Z"></path></svg>
  {english ? '3D model' : 'Modèle 3D'}
</a>

<style>
  /* MD3 filled button: 40 px high in a 48 px touch target (the transparent border, its colour inside it; TODO #59) */
  .model-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-sizing: border-box;
    min-height: 48px;
    padding: 0 1rem;
    border: 4px solid transparent;
    border-radius: var(--md-sys-shape-full);
    background: var(--md-sys-color-tertiary);
    background-clip: padding-box;
    color: var(--md-sys-color-on-tertiary);
    font-family: var(--lk-font-data);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .model-pill:hover {
    box-shadow: inset 0 0 0 100px rgb(14 36 48 / 0.08); /* MD3 hover state layer */
  }
  .model-pill:focus-visible,
  .model-pill:active {
    box-shadow: inset 0 0 0 100px rgb(14 36 48 / 0.1); /* MD3 focus and pressed state layers */
  }
  .model-pill:focus-visible {
    outline: 2px solid var(--md-sys-color-secondary);
    outline-offset: -2px;
  }
</style>
