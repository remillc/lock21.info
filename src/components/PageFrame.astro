---
// Page frame: Starlight's (0.42), plus the mobile menu on splash pages (the home page, /modele/). Those pages have no
// navigation column, so Starlight draws neither the menu button (☰) nor the menu, and on small screens the bar looked
// different from the rest of the site, without access to the navigation or the "Modèle 3D" button. Here, on splash
// pages, the button and the same menu (Sidebar.astro) are drawn on small screens only; wide screens are unchanged,
// except /modele: there the button and the menu are on wide screens too, the menu a panel over the page's left side
// (a popover at every width: a click outside or Esc closes it), so the viewer keeps its full width (Christian,
// 2026-10-23).
// When updating Starlight, compare with node_modules/@astrojs/starlight/dist/components/PageFrame.astro.
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle'
import Sidebar from 'virtual:starlight/components/Sidebar'

const { hasSidebar, entry } = Astro.locals.starlightRoute
const splash = !hasSidebar && entry.data.template === 'splash'
// The 3D model's page: its menu at every width (see above)
const drawer = splash && /^(en\/)?modele$/.test(entry.id)
---

<div class:list={['page sl-flex', { 'splash-menu': splash, 'drawer-menu': drawer }]}>
  <header class="header"><slot name="header" /></header>
  {
    (hasSidebar || splash) && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
        <MobileMenuToggle />
        <script>
          // The mobile menu uses the popover API to open and close without JavaScript. We enhance this
          // behaviour with focus trapping while the menu is open.
          class StarlightSidebarPane extends HTMLElement {
            constructor() {
              super()

              const desktopMediaQuery = matchMedia('(min-width: 50em)')

              // Remove the popover attribute on desktop viewports. It's only needed for the mobile menu; on /modele the
              // menu stays a popover at every width (a panel over the page)
              const drawer = Boolean(this.closest('.drawer-menu'))
              // The bar 6rem wider than the viewer's frame on each side (--l21-frame-left: the frame's left edge, measured)
              if (drawer) {
                // No room for the menu left of the frame (its 18.75rem, 2rem from the frame, 4rem for the gauge's labels:
                // 24.75rem): it opens from the window's left edge over the frame instead (l21-menu-overlay)
                const align = () => {
                  const frame = document.querySelector('.model-page .frame')
                  if (!frame) return
                  const left = frame.getBoundingClientRect().left
                  const root = document.documentElement
                  root.style.setProperty('--l21-frame-left', `${left}px`)
                  root.classList.toggle('l21-menu-overlay', left < 24.75 * parseFloat(getComputedStyle(root).fontSize))
                }
                requestAnimationFrame(align)
                addEventListener('resize', align)
              }
              const resetPopoverAttribute = () => {
                this.popover = desktopMediaQuery.matches && !drawer ? null : 'auto'
              }
              resetPopoverAttribute()
              desktopMediaQuery.addEventListener('change', () => resetPopoverAttribute())

              // Update the menu state when the sidebar popover is toggled.
              this.addEventListener('toggle', ({ newState }) => this.trapFocus(newState === 'open'))
            }
            /**
             * Trap keyboard focus inside the header and menu when the menu is expanded.
             * @param {boolean} shouldTrap
             */
            trapFocus(shouldTrap) {
              /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('.main-frame, .sl-skip-link')).forEach((el) => {
                el.toggleAttribute('inert', shouldTrap)
              })
            }
          }
          if (!customElements.get('sl-sidebar-pane')) customElements.define('sl-sidebar-pane', StarlightSidebarPane)
        </script>
        <sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">{hasSidebar ? <slot name="sidebar" /> : <Sidebar />}</div>
        </sl-sidebar-pane>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
</div>

<style>
  @layer l21.layout {
    @layer starlight.core {
      .page {
        flex-direction: column;
        min-height: 100vh;
      }

      .header {
        z-index: var(--sl-z-index-navbar);
        position: fixed;
        inset-inline-start: 0;
        inset-block-start: 0;
        width: 100%;
        height: var(--sl-nav-height);
        border-bottom: 1px solid var(--sl-color-hairline-shade);
        padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
        padding-inline-end: var(--sl-nav-pad-x);
        background-color: var(--sl-color-bg-nav);
      }

      :global([data-has-sidebar]) .header,
      .splash-menu .header {
        padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
      }

      .sidebar-pane {
        /* By default, user agents apply some opinionated styles to popovers, which we don’t want. */
        border: unset;
        padding: unset;
        height: unset;
        color: unset;

        position: fixed;
        z-index: var(--sl-z-index-menu);
        inset-block: var(--sl-nav-height) 0;
        inset-inline-start: 0;
        width: 100%;
        background-color: var(--sl-color-black);
        overflow-y: auto;
        scrollbar-gutter: stable;
      }

      .sidebar-content {
        height: 100%;
        min-height: max-content;
        padding: 1rem var(--sl-sidebar-pad-x) 0;
        flex-direction: column;
        gap: 1rem;
      }

      /* /modele on narrow screens: the menu a panel on the right, under its button, over the 3D display (Christian,
         2026-10-23), not the whole width */
      @media (max-width: 49.99rem) {
        .drawer-menu .sidebar-pane {
          inset-inline-start: auto;
          inset-inline-end: 0;
          width: min(var(--sl-sidebar-width), 85vw);
          box-shadow: var(--sl-shadow-lg);
        }
      }

      @media (min-width: 50rem) {
        .sidebar-content::after {
          content: '';
          padding-bottom: 1px;
        }
      }

      .main-frame {
        padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
        padding-inline-start: var(--sl-content-inline-start);
      }

      @media (min-width: 50rem) {
        :global([data-has-sidebar]) .header,
        .splash-menu .header {
          padding-inline-end: var(--sl-nav-pad-x);
        }
        .sidebar-pane {
          /* Make the sidebar visible on larger screens instead of deferring to popover state. */
          display: block;
          width: var(--sl-sidebar-width);
          background-color: var(--sl-color-bg-sidebar);
          border-inline-end: 1px solid var(--sl-color-hairline-shade);
        }
        /* Splash pages keep their full width on wide screens: no navigation column there */
        .splash-menu .sidebar {
          display: none;
        }
        /* /modele: the menu on wide screens too, a panel over the page's left side while open; room for its button */
        .drawer-menu .sidebar {
          display: block;
        }
        /* Against the viewer's frame, 2rem from its left edge (Christian, 2026-10-23), the depth gauge along its left
           edge as on the other pages (--l21-menu-left, below); no shadow; its text as usual. MD3 motion: unrolled from
           the frame leftward on opening (400 ms, emphasized decelerate), rolled back toward it on closing (200 ms,
           emphasized accelerate); the clip leaves room on the left for the depth gauge's labels */
        .drawer-menu .sidebar-pane {
          inset-inline-start: var(--l21-menu-left);
          clip-path: inset(-100vh -100vw -100vh 100%);
          transition:
            clip-path 200ms cubic-bezier(0.3, 0, 0.8, 0.15),
            display 200ms allow-discrete,
            overlay 200ms allow-discrete;

          &:not(:popover-open) {
            display: none;
          }

          &:popover-open {
            clip-path: inset(-100vh -100vw -100vh -6rem);
            transition-duration: 400ms;
            transition-timing-function: cubic-bezier(0.05, 0.7, 0.1, 1);
          }
        }
        @starting-style {
          .drawer-menu .sidebar-pane:popover-open {
            clip-path: inset(-100vh -100vw -100vh 100%);
          }
        }
        /* No room left of the frame (l21-menu-overlay, set by the script above): from the window's left edge, over the
           frame, unrolled left to right, with MD3's standard elevation for a modal drawer (level 1); no depth gauge */
        :global(.l21-menu-overlay) .drawer-menu .sidebar-pane {
          inset-inline-start: 0;
          clip-path: inset(-100vh 100% -100vh -100vw);
          box-shadow: var(--md-sys-elevation-level1);

          &:popover-open {
            clip-path: inset(-100vh -1rem -100vh -100vw);
          }
        }
        @starting-style {
          :global(.l21-menu-overlay) .drawer-menu .sidebar-pane:popover-open {
            clip-path: inset(-100vh 100% -100vh -100vw);
          }
        }
        @media (prefers-reduced-motion: reduce) {
          .drawer-menu .sidebar-pane {
            transition: none;
          }
        }
        /* The bar's content 6rem wider than the viewer's frame on each side (Christian, 2026-10-23): wider than the
           content, not edge to edge. Its button left of the logo: room for it at the start. --l21-bar-inset: from the
           window's edge (%: of the viewport, without its scrollbar), never less than the usual padding */
        .drawer-menu {
          --l21-bar-inset: max(var(--sl-nav-pad-x), var(--l21-frame-left, 0px) - 6rem);
        }
        .drawer-menu .header {
          padding-inline-start: calc(var(--l21-bar-inset) + var(--sl-menu-button-size) + var(--sl-nav-gap));
          padding-inline-end: var(--l21-bar-inset);
        }
      }
    }
  }
</style>

<style is:global>
  @layer l21.layout {
    /* /modele: Starlight's menu button (md:sl-hidden) shown on wide screens too, left of the logo, beside the panel it
       opens; outside the layers, to win */
    @media (min-width: 50rem) {
      .drawer-menu .sl-menu-button {
        display: flex;
        inset-inline-start: max(var(--sl-nav-pad-x), var(--l21-frame-left, 0px) - 6rem);
        inset-inline-end: auto;
      }
    }
    /* Every page: the menu button's three bars turn into an X and back (Christian, 2026-10-23): the outer bars rotate,
       the middle one shrinks away; bold, 3 px bars 18 px wide; Starlight's two icons hidden */
    nav .sl-menu-button svg {
      display: none;
    }
    nav .sl-menu-button {
      background-image: linear-gradient(currentColor, currentColor);
      background-size: 1.125rem 3px;
      background-position: center;
      background-repeat: no-repeat;
      /* MD3: the X forms in 400 ms (emphasized decelerate), the bars come back in 200 ms (emphasized accelerate) */
      transition: background-size 200ms cubic-bezier(0.3, 0, 0.8, 0.15);

      &::before,
      &::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 1.125rem;
        height: 3px;
        margin: -1.5px 0 0 -0.5625rem;
        border-radius: 1.5px;
        background: currentColor;
        transition: transform 200ms cubic-bezier(0.3, 0, 0.8, 0.15);
      }

      &::before {
        transform: translateY(-6px);
      }

      &::after {
        transform: translateY(6px);
      }

      &:has(~ :popover-open) {
        background-size: 0 3px;
        transition: background-size 400ms cubic-bezier(0.05, 0.7, 0.1, 1);
      }

      &:has(~ :popover-open)::before {
        transform: rotate(45deg);
        transition: transform 400ms cubic-bezier(0.05, 0.7, 0.1, 1);
      }

      &:has(~ :popover-open)::after {
        transform: rotate(-45deg);
        transition: transform 400ms cubic-bezier(0.05, 0.7, 0.1, 1);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      nav .sl-menu-button,
      nav .sl-menu-button::before,
      nav .sl-menu-button::after,
      nav .sl-menu-button:has(~ :popover-open),
      nav .sl-menu-button:has(~ :popover-open)::before,
      nav .sl-menu-button:has(~ :popover-open)::after {
        transition: none;
      }
    }

    /* /modele, menu open on wide screens: the other pages' depth gauge (Sidebar.astro) along the menu's left edge, its
       labels to its left, as on the other pages. --l21-menu-left: the menu 2rem from the frame, and at least 4rem from the
       window's edge (room for the labels) */
    .drawer-menu {
      --l21-menu-left: max(4rem, var(--l21-frame-left, 0px) - 2rem - var(--sl-sidebar-width));
    }
    @media (min-width: 50rem) {
      .l21-menu-overlay .drawer-menu .sidebar-pane .depth-ruler {
        display: none !important;
      }
      .drawer-menu .sidebar-pane .depth-ruler {
        --ruler-line: color-mix(in srgb, var(--md-sys-color-secondary) 40%, transparent);
        display: block;
        position: fixed;
        top: calc(var(--sl-nav-height) + 1.5rem);
        bottom: 2rem;
        left: calc(var(--l21-menu-left) - 1px);
        width: 0;
        border-left: 2px solid var(--ruler-line);
      }
      .drawer-menu .sidebar-pane .depth-ruler .mark {
        position: absolute;
        right: 0.625rem;
        transform: translateY(-50%);
        font-family: var(--l21-font-data);
        font-size: 0.75rem;
        color: var(--md-sys-color-on-surface-variant);
        white-space: nowrap;

        &::after {
          content: '';
          position: absolute;
          top: 50%;
          right: -0.625rem;
          width: 0.375rem;
          border-top: 2px solid var(--ruler-line);
        }
      }
      .drawer-menu .sidebar-pane .depth-ruler .bottom {
        color: var(--md-sys-color-tertiary-text);
        font-weight: 700;
      }
    }
  }
</style>
