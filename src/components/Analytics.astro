---
// Google Analytics 4, for every visit, with its cookies (no consent banner since 2026-10-21, at Christian's request).
// Included in every page's <head> by Head.astro. Without an ID (src/data/site.js, analytics.ga4) nothing is loaded.
// - Refusing (Québec's Loi 25: Google Analytics uses cookies): the privacy page's button (<l21-analytics-optout>,
//   AnalyticsOptOut.astro) keeps the choice in localStorage ('l21-consent': denied, or granted to accept again).
//   Nothing is loaded for a visitor who refused, including those who refused in the former banner.
// - ?no-analytics=1 in an address (TODO #95): nothing loaded nor sent for the rest of the visit (sessionStorage, so the
//   site's links keep it; gone when the tab closes), for tests and for Claude's checks of the live site. Read in the
//   <head>, before /modele cleans its address. The 3D viewer's telemetry (/api/log, not Google) is not affected.
// - Loaded late on purpose: Google's script weighs 180 KB and its long tasks slowed the page (PageSpeed). It comes on
//   the first interaction (tap, key, scroll) or 4 s after the page has loaded, whichever is first; the page view is
//   sent then, with the arrival address.
// - Page views: sent by hand, on the first load and after each client-side navigation (astro:page-load); automatic
//   ones would also count every ?cam= update of the /modele/ page as a page.
// - The arrival address is kept before /modele cleans its own (the 3D viewer keeps only ?cam=), so that the QR
//   codes' campaigns (utm_source=qr, utm_campaign=ra-table / ra-taille-reelle) reach the first page view.
// - Events (TODO #88; the list is on the privacy page): file_download (links with data-track-download: the KMZ and the
//   GLB); the visitors' other actions, from any script of the site as an l21:track event on document (detail: name,
//   params), and from the 3D viewer on /modele as a lock21:track message posted to the window (src/viewer/analytics.js). Outbound
//   links and scrolls: GA4's enhanced measurement (its own setting, in GA). An action before Google's script is loaded
//   waits for it (queue), unless the visitor refused the measurement.
import { site } from '../data/site'

// Not in development (npm run dev): tests on the PC and the phone would count as visits
const id = import.meta.env.PROD ? site.analytics.ga4 : ''
---

{
  id && (
    <>
      <meta name="lock21-ga4" content={id} />
      <script
        is:inline
        set:html="window.lock21Landing = window.lock21Landing || location.href; try { if (/[?&]no-analytics=1(&|$)/.test(location.search)) sessionStorage.setItem('l21-no-analytics', '1') } catch {}"
      />
    </>
  )
}

<script>
  const id = /** @type {HTMLMetaElement | null} */ (document.querySelector('meta[name="lock21-ga4"]'))?.content
  const KEY = 'l21-consent'

  /** @typedef {(...args: unknown[]) => void} Gtag */
  const w = /** @type {{ dataLayer: unknown[], gtag?: Gtag, lock21Landing?: string, lock21Analytics?: boolean }} */ (
    /** @type {unknown} */ (window)
  )

  /** The visitor's choice; denied for this visit with ?no-analytics=1 (read in the <head>, above) @returns {string | null} */
  function choice() {
    try {
      if (sessionStorage.getItem('l21-no-analytics')) return 'denied'
      return localStorage.getItem(KEY)
    } catch {
      return null
    }
  }

  let loaded = false
  let firstView = true
  let lastPath = ''

  function load() {
    if (loaded || !id) return
    loaded = true
    w.dataLayer = w.dataLayer || []
    w.gtag = function gtag() {
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer.push(arguments)
    }
    w.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' })
    w.gtag('consent', 'update', { analytics_storage: 'granted' })
    w.gtag('js', new Date())
    w.gtag('config', id, { send_page_view: false })
    const script = document.createElement('script')
    script.async = true
    script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`
    document.head.append(script)
    pageView()
    for (const [name, params] of queue.splice(0)) track(name, params)
  }

  function pageView() {
    if (!loaded || !w.gtag) return
    // The first one with the arrival address (QR code campaigns), the next ones with the current address
    const location = firstView && w.lock21Landing ? w.lock21Landing : window.location.href
    firstView = false
    lastPath = window.location.pathname
    w.gtag('event', 'page_view', { page_location: location, page_title: document.title })
  }

  // load(), on the first interaction or 4 s after the page's load event
  function loadSoon() {
    const events = ['pointerdown', 'keydown', 'scroll', 'touchstart']
    const options = { capture: true, passive: true }
    let timer = 0
    const start = () => {
      events.forEach((name) => window.removeEventListener(name, start, options))
      clearTimeout(timer)
      load()
    }
    events.forEach((name) => window.addEventListener(name, start, options))
    const arm = () => {
      timer = window.setTimeout(start, 4000)
    }
    if (document.readyState === 'complete') arm()
    else window.addEventListener('load', arm, { once: true })
  }

  /**
   * @param {string} name
   * @param {Record<string, string>} params
   */
  /** @type {[string, Record<string, unknown>][]} Actions before Google's script, sent when it comes */
  const queue = []
  /**
   * @param {string} name
   * @param {Record<string, unknown>} params
   */
  function track(name, params) {
    if (loaded && w.gtag) w.gtag('event', name, params)
    else if (choice() !== 'denied' && queue.length < 50) queue.push([name, params])
  }

  if (id && !w.lock21Analytics) {
    w.lock21Analytics = true
    if (choice() !== 'denied') loadSoon()
    // Measurement refused or accepted again from the privacy page
    document.addEventListener('l21-consent', (event) => {
      const granted = /** @type {CustomEvent<string>} */ (event).detail === 'granted'
      if (granted) load()
      else if (loaded && w.gtag) w.gtag('consent', 'update', { analytics_storage: 'denied' })
    })
    // Client-side navigations (ClientRouter): one page view per new path (astro:page-load also fires on the first
    // load, already counted by load())
    document.addEventListener('astro:page-load', () => {
      if (window.location.pathname !== lastPath) pageView()
    })
    // Downloads
    document.addEventListener('click', (event) => {
      const link = /** @type {HTMLAnchorElement | null | undefined} */ (
        /** @type {Element | null} */ (event.target)?.closest?.('a[data-track-download]')
      )
      if (!link) return
      const url = new URL(link.href, location.href)
      const file = url.pathname.split('/').pop() ?? ''
      track('file_download', { file_name: file, file_extension: file.split('.').pop() ?? '', link_url: url.href })
    })
    // The site's own actions, read from the page (delegated: they survive the client-side navigations)
    // - search: a result opened (the text searched); menu_open: the ☰ menu opened; select_content: a home card, the
    //   « Modèle 3D » pill, the home page's buttons, a figure enlarged (image-zoom.js)
    document.addEventListener('click', (event) => {
      const target = /** @type {Element | null} */ (event.target)
      const result = target?.closest?.('site-search a[href]')
      if (result) {
        const input = /** @type {HTMLInputElement | null} */ (document.querySelector('site-search input'))
        track('search', { search_term: input?.value.trim() ?? '' })
        return
      }
      const menu = target?.closest?.('[popovertarget="starlight__sidebar"]')
      if (menu && !document.getElementById('starlight__sidebar')?.matches(':popover-open')) {
        track('menu_open', {})
        return
      }
      const content = /** @type {HTMLElement | null | undefined} */ (target?.closest?.('[data-track-content]'))
      if (content) {
        track('select_content', { content_type: content.dataset.trackContent ?? '', item_id: content.dataset.trackId ?? content.getAttribute('href') ?? '' })
        return
      }
      const figure = /** @type {HTMLImageElement | null | undefined} */ (target?.closest?.('.sl-markdown-content figure img'))
      if (figure) track('select_content', { content_type: 'image_zoom', item_id: figure.currentSrc.split('/').pop() ?? '' })
    }, { capture: true })
    // theme_change, language_change: the footer's selects (Starlight's)
    document.addEventListener('change', (event) => {
      const select = /** @type {HTMLSelectElement | null} */ (event.target)
      if (select?.closest?.('starlight-theme-select')) track('theme_change', { theme: select.value })
      else if (select?.closest?.('starlight-lang-select')) track('language_change', { language: select.value.startsWith('/en') ? 'en' : 'fr' })
    })
    // The other actions, sent by a script of the site (l21:track)
    document.addEventListener('l21:track', (event) => {
      const { name, params } = /** @type {CustomEvent<{ name: string, params?: Record<string, unknown> }>} */ (event).detail ?? {}
      if (typeof name === 'string') track(name, params ?? {})
    })
    // The 3D viewer's actions (src/viewer/analytics.js, on /modele: posted to this window)
    window.addEventListener('message', (event) => {
      if (event.origin !== location.origin || event.data?.type !== 'lock21:track' || typeof event.data.name !== 'string') return
      track(event.data.name, event.data.params ?? {})
    })
  }
</script>
