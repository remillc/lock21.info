---
// Footer of the mobile menu: Starlight's, without the social-icons slot. That slot holds the "Modèle 3D" pill
// (HeaderActions.astro), which on small screens sits at the top of the menu instead (Sidebar.astro).
import LanguageSelect from 'virtual:starlight/components/LanguageSelect'
import ThemeSelect from 'virtual:starlight/components/ThemeSelect'
---

<div class="mobile-preferences sl-flex">
  <ThemeSelect />
  <LanguageSelect />
</div>

<style>
  .mobile-preferences {
    justify-content: space-between;
    flex-wrap: wrap;
    border-top: 1px solid var(--sl-color-gray-6);
    column-gap: 1rem;
    padding: 0.5rem 0;
  }
</style>
