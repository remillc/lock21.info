---
// Footer: Starlight's (previous/next page links), then the dark olive bar of the design with the site's name, the theme
// select (Starlight's, moved here from the header: astro.config.mjs; the language select is in the header since
// 2026-10-30, HeaderActions.astro), the copyright and the licence
// (CC BY 4.0, as for the 3D model: /modele).
// Both stay together at the bottom of the window on short pages (margin-top: auto; the flex columns in custom.scss).
import Default from '@astrojs/starlight/components/Footer.astro'
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro'
import { pageLang } from '../lib/i18n'
import { m } from '../paraglide/messages.js'
import ScrollTables from './ScrollTables.astro'

const lang = pageLang(Astro.locals)
// Every message in the page's language (messages/site/)
const o = { locale: lang }
const privacy = lang === 'en' ? '/en/confidentialite' : '/confidentialite'
// From the first dive (2024) to the year of the build
const years = `2024–${new Date().getFullYear()}`
const licence = `https://creativecommons.org/licenses/by/4.0/deed.${lang}`
---

<div class="page-end">
<Default />
<ScrollTables />
<script is:inline>
  // Previous / next page (Starlight's links): prefetched as soon as they are on screen (Astro prefetch, "viewport"),
  // the likely next step. Inline: runs while the page is parsed and again after each client-side navigation, before
  // Astro scans the links.
  for (const link of document.querySelectorAll('.pagination-links a')) link.dataset.astroPrefetch = 'viewport'
</script>
<div class="site-footer">
  <span translate="no">{m.site_wordmark({}, o)} · {m.footer_notebook({}, o)}</span>
  <div class="preferences l21-select print:hidden">
    <ThemeSelect />
  </div>
  <span>© {years} Christian Rémillard · {m.footer_licence({}, o)} <a href={licence} rel="license">CC BY 4.0</a>
    · <a href={privacy}>{m.footer_privacy({}, o)}</a></span>
</div>
</div>

<style>
  @layer l21.layout {
    .page-end {
      margin-top: auto;
    }

    .site-footer {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem 1.5rem;
      margin-top: 2rem;
      padding: 1.25rem 1.5rem;
      border-radius: var(--md-sys-shape-large);
      background: var(--l21-bar);
      color: var(--l21-bar-muted);
      font-family: var(--l21-font-data);
      font-size: 0.8125rem;
      line-height: 1.5;
    }
    .site-footer a {
      color: var(--l21-bar-link);
    }
    .preferences {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }
</style>
