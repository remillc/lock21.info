---
// Footer: Starlight's (previous/next page links), then the navy bar of the design with the author and the credit for
// Nick Baets' drawings.
import Default from '@astrojs/starlight/components/Footer.astro'

const english = Astro.locals.starlightRoute.lang?.startsWith('en')
---

<Default />
<div class="site-footer">
  <span translate="no">{english ? 'LOCK/21' : 'ÉCLUSE/21'} · {english ? 'field notebook by' : 'carnet de terrain de'} Christian Rémillard</span>
  <span>{english ? 'Original drawings' : "Dessins d'origine"}: Nick Baets (1988), via <a href="https://saveontarioshipwrecks.ca/chapter-ottawa/">Save Ontario Shipwrecks</a></span>
</div>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--md-sys-shape-large);
    background: var(--lk-bar);
    color: var(--lk-bar-muted);
    font-family: var(--lk-font-data);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .site-footer a {
    color: #3cc2bc;
  }
</style>
