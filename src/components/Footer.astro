---
// Footer: Starlight's (previous/next page links), then the navy bar of the design with the site's name, the copyright and
// the licence (CC BY 4.0, as for the 3D model: /modele/).
// Both stay together at the bottom of the window on short pages (margin-top: auto; the flex columns in custom.scss).
import Default from '@astrojs/starlight/components/Footer.astro'

const english = Astro.locals.starlightRoute.lang?.startsWith('en')
// From the first dive (2024) to the year of the build
const years = `2024–${new Date().getFullYear()}`
const licence = `https://creativecommons.org/licenses/by/4.0/deed.${english ? 'en' : 'fr'}`
---

<div class="page-end">
<Default />
<script is:inline>
  // Previous / next page (Starlight's links): prefetched as soon as they are on screen (Astro prefetch, "viewport"),
  // the likely next step. Inline: runs while the page is parsed and again after each client-side navigation, before
  // Astro scans the links.
  for (const link of document.querySelectorAll('.pagination-links a')) link.dataset.astroPrefetch = 'viewport'
</script>
<div class="site-footer">
  <span translate="no">{english ? 'LOCK/21' : 'ÉCLUSE/21'} · {english ? 'field notebook' : 'carnet de terrain'}</span>
  <span>© {years} Christian Rémillard · {english ? 'License' : 'Licence'} <a href={licence} rel="license">CC BY 4.0</a></span>
</div>
</div>

<style>
  .page-end {
    margin-top: auto;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--md-sys-shape-large);
    background: var(--lk-bar);
    color: var(--lk-bar-muted);
    font-family: var(--lk-font-data);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .site-footer a {
    color: #3cc2bc;
  }
</style>
