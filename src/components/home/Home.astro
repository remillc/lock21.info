---
// Home page (docs/system-design.md, "E2 · Sonar"): depth gauge, title and instrument panel, framed render of the model, three
// entry cards, journal excerpts. Every number comes from the dive log or the 3D manifest at build time. The links to the
// next steps (buttons, render, cards, journal) are prefetched as soon as they are on screen (Astro prefetch, "viewport").
// French at /, English at /en/ (src/lib/i18n.js): the text below in both languages.
import { Image } from 'astro:assets'
import render from '../../assets/home/render-zone12.webp'
import { site } from '../../data/site'
import { dives, totalMinutes, formatDuration, latestWithNotes } from '../../lib/diveLog'
import { pageLang, localPath, locale } from '../../lib/i18n'
import { zonesOnline } from '../../lib/manifest'

const lang = pageLang(Astro.locals)
const en = lang === 'en'
const zones = await zonesOnline()
const excerpts = latestWithNotes(3, lang)
const journal = localPath('/collecte/journal-des-plongees', lang)
const about = localPath('/a-propos', lang)
const viewer = localPath(site.viewer, lang)
// The render's point of view in the viewer (?cam=x,y,z,tx,ty,tz: metres, y up; Blender's x, z, -y): zone 12 from the
// west, 10 ft above the floor, as in the image
const renderView = `${viewer}?cam=-53,3.64,-16.8,-37,5.09,-16.8`
const ft = en ? 'ft' : 'pi'

const t = en
  ? {
      eyebrow: 'FIELD NOTEBOOK · UNDERWATER PHOTOGRAMMETRY',
      title: ['Lock 21,', 'measured underwater.'],
      lead: 'Every dive, every setting, every zone, up to the 3D model of the submerged lock.',
      explore: 'Explore the 3D model',
      journal: 'Dive log',
      survey: 'Survey',
      surveyTitle: 'SURVEY',
      status: 'IN PROGRESS',
      depth: 'BOTTOM DEPTH',
      dives: 'DIVES',
      under: 'UNDERWATER',
      online: 'ZONES ONLINE',
      latest: 'LATEST',
      alt: 'Render of the 3D model of zone 12 seen from the west, sunlight rays falling through the water: masonry pier, spillway sluice gates and walkway, covered in zebra mussels',
      aboutTitle: 'What this site is for',
      about:
        "Lock 21 has been underwater since 1958, at Dickinson Landing, one of the Lost Villages of the St. Lawrence. I set out to digitize the whole structure in 3D, zone by zone, with photogrammetry. This site is the field notebook: it shows the lock to people who don't dive, helps divers plan their dives, and documents the method so others can do it elsewhere.",
      aboutMore: 'About the project →',
      start: 'Where to start',
      startSub: 'Three ways in, depending on what brings you here.',
      excerptsTitle: 'From the dive log',
      /** @param {number} n */
      all: (n) => `All ${n} dives →`,
      /**
       * @param {number} n
       * @param {string} d
       */
      total: (n, d) => `Total: ${n} dives · ${d}`,
    }
  : {
      eyebrow: 'CARNET DE TERRAIN · PHOTOGRAMMÉTRIE SOUS-MARINE',
      title: ["L'écluse 21,", "mesurée sous l'eau."],
      lead: "Chaque plongée, chaque réglage, chaque zone, jusqu'au modèle 3D de l'écluse submergée.",
      explore: 'Explorer le modèle 3D',
      journal: 'Journal des plongées',
      survey: 'Relevé',
      surveyTitle: 'RELEVÉ',
      status: 'EN COURS',
      depth: 'PROFONDEUR DU FOND',
      dives: 'PLONGÉES',
      under: "SOUS L'EAU",
      online: 'ZONES EN LIGNE',
      latest: 'DERNIÈRE',
      alt: "Rendu du modèle 3D de la zone 12 vu de l'ouest, des rayons de soleil traversant l'eau: pilier de maçonnerie, vannes du déversoir et passerelle, couverts de moules zébrées",
      aboutTitle: 'À quoi sert ce site',
      about:
        "L'écluse 21 est sous l'eau depuis 1958, à Dickinson Landing, un des villages engloutis du Saint-Laurent. J'ai eu le projet de numériser toute la structure en 3D, zone par zone, par photogrammétrie. Ce site en est le carnet de terrain: il montre l'écluse à ceux qui ne plongent pas, aide les plongeurs à préparer leur plongée et documente la méthode pour que d'autres la refassent ailleurs.",
      aboutMore: 'À propos du projet →',
      start: 'Par où commencer',
      startSub: "Trois portes d'entrée, selon ce qui vous amène.",
      excerptsTitle: 'Extraits du journal',
      /** @param {number} n */
      all: (n) => `Les ${n} plongées →`,
      /**
       * @param {number} n
       * @param {string} d
       */
      total: (n, d) => `Total: ${n} plongées · ${d}`,
    }

const entries = (
  en
    ? [
        { no: '01', title: 'Diving the site', text: 'Zones, depths, the current in the canal.', label: 'divers', href: '/decoupage-du-site' },
        { no: '02', title: 'The method', text: 'GoPro Hero6, Metashape, Blender.', label: 'photogrammetry', href: '/workflow/extraction-des-photos' },
        // The problems section's first page (it has no index), Christian, 2026-10-25
        { no: '03', title: 'The problems', text: 'Distortion, current, sharpness: what went wrong.', label: 'lessons', href: '/questions/alignement-chunks' },
      ]
    : [
        { no: '01', title: 'Plonger le site', text: 'Zones, profondeurs, courant du canal.', label: 'plongeurs', href: '/decoupage-du-site' },
        { no: '02', title: 'La méthode', text: 'GoPro Hero6, Metashape, Blender.', label: 'photogrammétrie', href: '/workflow/extraction-des-photos' },
        { no: '03', title: 'Les problèmes', text: 'Distorsion, courant, netteté: ce qui a mal tourné.', label: 'leçons', href: '/questions/alignement-chunks' },
      ]
).map((e) => ({ ...e, href: localPath(e.href, lang) }))
---

<div class="home not-content">
  <div class="gauge" aria-hidden="true">
    <span>0 {ft}</span>
    <span>15 {ft}</span>
    <span>30 {ft}</span>
    <span>45 {ft}</span>
    <span class="bottom">{site.bottomDepthFt} {ft}</span>
  </div>

  <div class="main">
    <section class="hero">
      <div class="intro">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 id="_top">{t.title[0]}<br />{t.title[1]}</h1>
        <p class="lead">{t.lead}</p>
        <div class="actions">
          <a class="button filled" href={viewer} data-astro-prefetch="viewport">{t.explore}</a>
          <a class="button outlined" href={journal} data-astro-prefetch="viewport">{t.journal}</a>
        </div>
      </div>

      <section class="panel" aria-label={t.survey}>
        <div class="panel-head">
          <span>{t.surveyTitle}</span>
          <span class="status"><span class="dot"></span>{t.status}</span>
        </div>
        <div class="wide">
          <div class="label">{t.depth}</div>
          <div class="depth">{site.bottomDepthFt}<span> {ft}</span></div>
          <div class="label">{site.bottomDepthM.toLocaleString(locale(lang))} m</div>
        </div>
        <div><div class="label">{t.dives}</div><div class="reading">{dives.length}</div></div>
        <div><div class="label">{t.under}</div><div class="reading">{formatDuration(totalMinutes, false, lang)}</div></div>
        <div><div class="label">{t.online}</div><div class="reading">{zones.count}<span class="of"> / {site.zonesTotal}</span></div></div>
        <div><div class="label">{t.latest}</div><div class="reading">Z{zones.latest}</div></div>
      </section>
    </section>

    <a class="render" href={renderView} data-astro-prefetch="viewport">
      <Image src={render} alt={t.alt} widths={[640, 960, 1280]} sizes="(min-width: 75rem) 1100px, 100vw" />
      <span class="chip">ZONE 12 · 13 M FACES · TEX 12 464 PX</span>
    </a>

    <section class="block">
      <h2>{t.aboutTitle}</h2>
      <p class="about">{t.about}</p>
      <a class="more" href={about} data-astro-prefetch="viewport">{t.aboutMore}</a>
    </section>

    <section class="block">
      <h2>{t.start}</h2>
      <p class="sub">{t.startSub}</p>
      <div class="cards">
        {entries.map((e) => (
          <a class="card" href={e.href} data-astro-prefetch="viewport">
            <span class="card-no">{e.no}</span>
            <span class="card-title">{e.title}</span>
            <span class="card-text">{e.text}</span>
            <span class="card-path">{e.label} →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="block">
      <div class="block-head">
        <h2>{t.excerptsTitle}</h2>
        <a class="more" href={journal} data-astro-prefetch="viewport">{t.all(dives.length)}</a>
      </div>
      <ol class="timeline">
        {excerpts.map((d) => (
          <li>
            <div class="meta">
              <span class="no">No {d.no}</span>
              <span>{d.date}</span>
              {d.zones && <span>zone {d.zones}</span>}
              <span class="duration">{d.minutes} min</span>
            </div>
            <p>{d.notes}</p>
          </li>
        ))}
      </ol>
      <p class="total">{t.total(dives.length, formatDuration(totalMinutes, true, lang))}</p>
    </section>
  </div>
</div>

<style>
  .home {
    display: flex;
    gap: 2.5rem;
    padding-block: 1rem 3rem;
    color: var(--md-sys-color-on-surface);
  }

  /* Depth gauge: as high as the window below the bar (like the navigation's ruler on the other pages), its marks
     spread evenly from the surface to the bottom, and it stays in view while scrolling; hidden on phones */
  .gauge {
    flex: 0 0 4.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: sticky;
    top: calc(var(--sl-nav-height) + 1.5rem);
    height: calc(100dvh - var(--sl-nav-height) - 3.5rem);
    align-self: flex-start;
    margin-top: 0.5rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--md-sys-color-secondary);
    font-family: var(--l21-font-data);
    font-size: 0.75rem;
    color: var(--md-sys-color-on-surface-variant);
  }
  .gauge .bottom {
    color: var(--md-sys-color-tertiary-text);
    font-weight: 700;
  }
  @media (max-width: 50rem) {
    .gauge {
      display: none;
    }
  }

  .main {
    flex: 1;
    min-width: 0;
  }

  /* Hero: title and buttons, instrument panel */
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: stretch;
  }
  .intro {
    flex: 999 1 26rem;
    min-width: 0;
  }
  .eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--l21-font-data);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--md-sys-color-secondary);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 3.5625rem);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--md-sys-color-on-surface);
  }
  .lead {
    margin: 1.25rem 0 1.75rem;
    max-width: 32rem;
    color: var(--md-sys-color-on-surface-variant);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 1.5rem;
    border-radius: var(--md-sys-shape-medium);
    font-family: var(--l21-font-data);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .filled {
    background-color: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }
  .outlined {
    border: 2px solid var(--md-sys-color-primary);
    color: var(--md-sys-color-primary);
  }
  /* MD3 hover state layer: a layer over the whole surface, under its content (an inset shadow covered only 100 px from
     each edge: the cards' middle stayed bare, a light rectangle, Christian 2026-10-25); their colour is a
     background-color, so the layer adds to it */
  .button:hover,
  .card:hover {
    background-image: linear-gradient(color-mix(in srgb, currentColor 8%, transparent) 0 0);
  }

  .panel {
    flex: 1 1 20rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: var(--md-sys-shape-extra-large);
    border: 2px solid var(--l21-panel-outline);
    background: var(--l21-panel);
    color: var(--l21-bar-text);
    font-family: var(--l21-font-data);
  }
  .panel-head {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .panel-head,
  .label {
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--l21-bar-muted);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--l21-bar-link);
  }
  .wide {
    grid-column: 1 / -1;
  }
  .depth {
    font-size: 2.8125rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--md-sys-color-tertiary);
  }
  .depth span {
    font-size: 1.375rem;
  }
  .reading {
    white-space: nowrap;
    font-size: clamp(1.25rem, 1.8vw, 1.625rem);
    line-height: 1.3;
    font-weight: 700;
  }
  .of {
    font-size: 1rem;
    color: var(--l21-bar-muted);
  }

  /* Render of the model */
  .render {
    position: relative;
    display: block;
    margin-top: 2.5rem;
    border: 2px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-extra-large);
    overflow: hidden;
    background: var(--l21-panel);
  }
  .render img {
    display: block;
    width: 100%;
    height: clamp(14rem, 32vw, 25rem);
    object-fit: cover;
  }
  .chip {
    position: absolute;
    top: 0.875rem;
    left: 0.875rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--md-sys-shape-full);
    background: var(--l21-bar);
    color: var(--l21-bar-text);
    font-family: var(--l21-font-data);
    font-size: 0.75rem;
  }

  /* Sections */
  .block {
    margin-top: 4rem;
  }
  h2 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.25;
    font-weight: 800;
    color: var(--md-sys-color-on-surface);
  }
  .sub {
    margin: 0.25rem 0 1.25rem;
    color: var(--md-sys-color-on-surface-variant);
  }
  .about {
    max-width: 48rem;
    margin: 0.75rem 0 0.75rem;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.5rem;
    border: 2px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-large-increased);
    background-color: var(--md-sys-color-surface-container-lowest);
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
  }
  :global([data-theme='dark']) .card,
  :global(:root:not([data-theme='light'])) .card {
    background-color: var(--md-sys-color-surface-container);
  }
  .card-no {
    font-family: var(--l21-font-data);
    font-size: 2.25rem;
    line-height: 1;
    font-weight: 700;
    color: var(--md-sys-color-secondary);
  }
  .card-title {
    font-size: 1.375rem;
    font-weight: 800;
  }
  .card-text {
    font-size: 0.9375rem;
    color: var(--md-sys-color-on-surface-variant);
  }
  .card-path {
    font-family: var(--l21-font-data);
    font-size: 0.8125rem;
    color: var(--md-sys-color-secondary);
  }

  .block-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .more {
    font-family: var(--l21-font-data);
    font-size: 0.875rem;
    color: var(--md-sys-color-secondary);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.25rem;
    border-left: 2px solid var(--md-sys-color-secondary);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .timeline li {
    margin: 0;
    padding: 1.125rem 1.25rem;
    border: 2px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-large);
    background: var(--md-sys-color-surface-container-lowest);
  }
  :global(:root:not([data-theme='light'])) .timeline li {
    background: var(--md-sys-color-surface-container);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    font-family: var(--l21-font-data);
    font-size: 0.8125rem;
    color: var(--md-sys-color-on-surface-variant);
  }
  .no {
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
  }
  .duration {
    margin-left: auto;
    padding: 0.125rem 0.625rem;
    border-radius: var(--md-sys-shape-small);
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
  }
  :global(:root:not([data-theme='light'])) .duration {
    background: var(--md-sys-color-surface-container-lowest);
  }
  .timeline p {
    margin: 0.5rem 0 0;
  }
  .total {
    margin: 1rem 0 0;
    font-family: var(--l21-font-data);
    font-size: 0.875rem;
    font-weight: 700;
  }
</style>
