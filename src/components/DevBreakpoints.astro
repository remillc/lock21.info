---
// Development aid, the same as OpenCaves' DebugBreakpoints (src/components/utils/DebugBreakpoints.jsx): a small red
// label at the top left of the screen with the current breakpoint and, on a second line, its interval in px, using
// MUI's default breakpoints (xs 0, sm 600, md 900, lg 1200, xl 1536 px). Rendered by SiteTitle.astro (header) on the dev server only, never in production.
---

<l21-dev-breakpoints class="dev-breakpoints" aria-hidden="true"></l21-dev-breakpoints>

<script>
  const breakpoints: [string, number][] = [
    ['xl', 1536],
    ['lg', 1200],
    ['md', 900],
    ['sm', 600],
    ['xs', 0],
  ]

  class DevBreakpoints extends HTMLElement {
    update = () => {
      // Breakpoint code, then its interval in px on a second line ("1200 - 1535"; the last one is open-ended)
      const i = breakpoints.findIndex(([, min]) => window.innerWidth >= min)
      const [name, min] = breakpoints[i]
      const max = i > 0 ? breakpoints[i - 1][1] - 1 : '∞'
      this.textContent = `${name}
${min} - ${max}`
    }

    connectedCallback() {
      this.update()
      window.addEventListener('resize', this.update)
    }

    // A client-side navigation replaces the header: the old label stops listening
    disconnectedCallback() {
      window.removeEventListener('resize', this.update)
    }
  }
  customElements.define('l21-dev-breakpoints', DevBreakpoints)
</script>

<style>
  /* Same look and place as in OpenCaves. Fixed rather than absolute: here it is mounted in the header, not at the root
     of the page. MUI's default font stack (OpenCaves loads Roboto; here the fallback applies). */
  .dev-breakpoints {
    position: fixed;
    left: 0.5em;
    top: 0.5em;
    font-family: 'Roboto', 'Helvetica', 'Arial', sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: normal;
    color: #fff;
    background-color: red;
    line-height: 1;
    white-space: pre; /* the interval on its own line */
    text-align: center; /* the code centred over its interval */
    padding: 0.2em;
    opacity: 0.75;
    z-index: 1000000;
    pointer-events: none;
  }
</style>
