---
// Development aid, the same as OpenCaves' DebugBreakpoints (src/components/utils/DebugBreakpoints.jsx): a small red
// label at the top left of the screen with the current breakpoint, using MUI's default breakpoints (xs 0, sm 600,
// md 900, lg 1200, xl 1536 px). Rendered by SiteTitle.astro (header) on the dev server only, never in production.
---

<dev-breakpoints class="dev-breakpoints" aria-hidden="true"></dev-breakpoints>

<script>
  const breakpoints: [string, number][] = [
    ['xl', 1536],
    ['lg', 1200],
    ['md', 900],
    ['sm', 600],
    ['xs', 0],
  ]

  class DevBreakpoints extends HTMLElement {
    connectedCallback() {
      const update = () => {
        this.textContent = breakpoints.find(([, min]) => window.innerWidth >= min)![0]
      }
      update()
      window.addEventListener('resize', update)
    }
  }
  customElements.define('dev-breakpoints', DevBreakpoints)
</script>

<style>
  /* Same look and place as in OpenCaves. Fixed rather than absolute: here it is mounted in the header, not at the root
     of the page. MUI's default font stack (OpenCaves loads Roboto; here the fallback applies). */
  .dev-breakpoints {
    position: fixed;
    left: 0.5em;
    top: 0.5em;
    font-family: 'Roboto', 'Helvetica', 'Arial', sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: normal;
    color: #fff;
    background-color: red;
    line-height: 1;
    padding: 0.2em;
    opacity: 0.75;
    z-index: 1000000;
    pointer-events: none;
  }
</style>
