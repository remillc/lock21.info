---
// <l21-scroll-tables>, in the footer of every page: a Markdown table wider than the column scrolls sideways
// (custom.scss), and a keyboard must reach it to scroll it (WCAG 2.1.1, axe scrollable-region-focusable). The tables
// that overflow get tabindex="0" (and the focus ring); the others stay out of the tab order. Each overflowing box also
// says on which sides there is more to see, data-more="start", "end" or both (usability audit V36): custom.scss fades
// those edges, so the table shows that it scrolls. The dive log on phones scrolls in its own box (DiveLog.astro), which
// gets the same. Kept up to date as the window changes size and the box scrolls. A Custom Element: set up again on
// every page under client-side routing (docs/guidelines.md).
---

<l21-scroll-tables hidden></l21-scroll-tables>

<script>
  /**
   * Marks the box as reachable by the keyboard and names the sides where more is hidden
   * @param {Element} box
   */
  function mark(box) {
    if (box.scrollWidth <= box.clientWidth + 1) {
      box.removeAttribute('tabindex')
      box.removeAttribute('data-more')
      return
    }
    box.setAttribute('tabindex', '0')
    // scrollLeft is negative in right-to-left text; the site is left to right, its magnitude covers both
    const left = Math.abs(box.scrollLeft)
    const more = []
    if (left > 1) more.push('start')
    if (left < box.scrollWidth - box.clientWidth - 1) more.push('end')
    box.setAttribute('data-more', more.join(' '))
  }

  class ScrollTables extends HTMLElement {
    /** @type {ResizeObserver | null} */
    observer = null
    /** @type {AbortController | null} */
    listeners = null

    connectedCallback() {
      const boxes = document.querySelectorAll('.sl-markdown-content :is(table, .dive-log)')
      if (!boxes.length) return
      this.observer = new ResizeObserver((entries) => {
        for (const { target } of entries) mark(target)
      })
      this.listeners = new AbortController()
      for (const box of boxes) {
        this.observer.observe(box)
        box.addEventListener('scroll', () => mark(box), { passive: true, signal: this.listeners.signal })
      }
    }

    disconnectedCallback() {
      this.observer?.disconnect()
      this.observer = null
      this.listeners?.abort()
      this.listeners = null
    }
  }
  if (!customElements.get('l21-scroll-tables')) customElements.define('l21-scroll-tables', ScrollTables)
</script>
