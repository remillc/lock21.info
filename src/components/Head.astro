---
// Starlight's <head> plus Astro's client-side router (ClientRouter): links swap the page without a full reload.
// Starlight doesn't support the router officially; the gaps are filled here and in Search.astro:
// - theme: the new document arrives without data-theme (Starlight sets it in a script at full load): copied over
//   before the swap, so there is no flash;
// - sidebar: its scroll position is kept (Starlight saves it only when the page unloads), and the current page
//   shown (its group unfolded, the others closed at page load, scrolled to when out of view);
// - search: kept across pages (Search.astro); the new page's copy is emptied before the swap, and the dialog is
//   closed after a navigation from a result; a link to the other language loads the page in full (the search
//   starts again in that language).
// Page transition: docs/system-design.md (Motion), styles in custom.scss.
import Default from '@astrojs/starlight/components/Head.astro'
import { ClientRouter } from 'astro:transitions'
import Analytics from './Analytics.astro'
import { pageLang } from '../lib/i18n.js'
// Fonts seen at the top of every page, fetched with the HTML instead of after the stylesheet: Archivo 400 (text), 700
// (the left menu's labels, weight 600: drawn first in a lighter weight, then bold, a flicker; TODO #87) and 800 (titles:
// the home page's title is its largest element), JetBrains Mono 700 (the "Modèle 3D" pill, the home
// panel's numbers) and 800 (the ÉCLUSE/21 wordmark). Same files as the @fontsource stylesheets (astro.config.mjs).
import archivo400 from '@fontsource/archivo/files/archivo-latin-400-normal.woff2?url'
import archivo700 from '@fontsource/archivo/files/archivo-latin-700-normal.woff2?url'
import archivo800 from '@fontsource/archivo/files/archivo-latin-800-normal.woff2?url'
import mono700 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2?url'
import mono800 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-800-normal.woff2?url'

const fonts = [archivo400, archivo700, archivo800, mono700, mono800]
// The web app (TODO #81): its manifest in the page's language (installed from an English page, the app opens on /en/),
// the icon iOS shows on the home screen (public/icons/, tools/pwa/make_icons.mjs), and the service worker
// (public/sw.js: the network first, the pages read kept for offline), in production only
const manifest = pageLang(Astro.locals) === 'en' ? '/manifest-en.webmanifest' : '/manifest.webmanifest'
---

<Default />
{fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<link rel="manifest" href={manifest} />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<meta name="theme-color" content="#1b1e15" />
<ClientRouter />
<Analytics />
<script is:inline>
  // The browser's offer to install (Chrome, Edge, Android): kept for the « Installer l'app » button of the « À propos »
  // page (InstallApp.astro, TODO #110); preventDefault stops Chrome's own bar at the bottom of a phone's screen (never
  // a popup at arrival). In development too (the button tried on npm run dev)
  if (!window.lock21InstallWatch) {
    window.lock21InstallWatch = true
    addEventListener('beforeinstallprompt', (event) => {
      event.preventDefault()
      window.lock21Install = event
      document.dispatchEvent(new Event('l21:installable'))
    })
    addEventListener('appinstalled', () => {
      window.lock21Install = null
      document.dispatchEvent(new Event('l21:installed'))
      document.dispatchEvent(new CustomEvent('l21:track', { detail: { name: 'app_installed', params: {} } }))
    })
  }
</script>
{
  import.meta.env.PROD && (
    <script is:inline>
      if ('serviceWorker' in navigator && !window.lock21Worker) {
        window.lock21Worker = true
        navigator.serviceWorker.register('/sw.js').catch(() => {})
      }
    </script>
  )
}
<script is:inline>
  if (!window.lock21Router) {
    window.lock21Router = true
    let sidebarScroll = 0
    // The groups of the menu: only the current page's open (Christian, 2026-10-23). Starlight keeps in the tab which
    // groups were open and opens them again before the page shows (its SidebarPersister, wide screens), then the
    // others closed (revealCurrent, below) after the first paint: a flicker (TODO #87). That memory of the groups is
    // forgotten before each page (its scroll position kept), so the HTML's groups stay as Starlight drew them
    const forgetGroups = () => {
      try {
        const state = JSON.parse(sessionStorage.getItem('sl-sidebar-state') || '0')
        if (state && Array.isArray(state.open)) {
          state.open = state.open.map(() => null)
          sessionStorage.setItem('sl-sidebar-state', JSON.stringify(state))
        }
      } catch {}
    }
    forgetGroups()
    // A link to the other language: a full page load, not a swap. The kept search would otherwise stay in the first
    // page's language (Pagefind reads <html lang> once, when it starts; usability audit V8)
    const isEnglish = (path) => path === '/en' || path.startsWith('/en/')
    document.addEventListener('astro:before-preparation', (event) => {
      if (isEnglish(event.to.pathname) !== isEnglish(event.from.pathname)) event.preventDefault()
    })
    document.addEventListener('astro:before-swap', (event) => {
      forgetGroups()
      event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme
      // The kept search replaces the new page's: emptied first, so that its element is never built (its constructor
      // would add a Ctrl+K listener bound to a dialog that leaves the page)
      event.newDocument.querySelector('[data-astro-transition-persist="site-search"]')?.replaceChildren()
      sidebarScroll = document.getElementById('starlight__sidebar')?.scrollTop ?? 0
    })
    document.addEventListener('astro:after-swap', () => {
      const sidebar = document.getElementById('starlight__sidebar')
      if (sidebar) sidebar.scrollTop = sidebarScroll
      document.querySelector('site-search dialog[open]')?.close()
    })
    // The menu shows the current page (Christian, 2026-10-23): its group unfolded (the others closed at page load),
    // and scrolled to it when it is out
    // of view (otherwise the kept scroll stays). At every page load, and when the menu (a popover on phones and on
    // /modele) opens: closed, it has no size to measure
    // closeOthers (at page load, Christian 2026-10-23): the other groups closed, only the current page's open (after
    // Starlight's own memory of the open groups)
    const revealCurrent = (closeOthers = false) => {
      const pane = document.getElementById('starlight__sidebar')
      const link = pane?.querySelector('a[aria-current="page"]')
      if (!pane) return
      if (closeOthers) pane.querySelectorAll('details').forEach((group) => (group.open = Boolean(link && group.contains(link))))
      if (!link) return
      for (let group = link.closest('details'); group; group = group.parentElement?.closest('details')) group.open = true
      const box = pane.getBoundingClientRect()
      const item = link.getBoundingClientRect()
      if (box.height === 0) return
      if (item.top < box.top || item.bottom > box.bottom) pane.scrollTop += item.top - box.top - (box.height - item.height) / 2
    }
    // The language select is at the bottom of the page (the footer): the other language's page opens at its bottom too,
    // not at its top (Christian, 2026-10-26). The choice is noted as it changes (a full load follows, see above), and
    // read by the next page, within a few seconds
    const LANGUAGE_KEY = 'l21-language-bottom'
    document.addEventListener('change', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('starlight-lang-select')) return
      try {
        sessionStorage.setItem(LANGUAGE_KEY, String(Date.now()))
      } catch {}
    }, true)
    let toBottom = false
    try {
      toBottom = Date.now() - Number(sessionStorage.getItem(LANGUAGE_KEY) ?? 0) < 10000
      sessionStorage.removeItem(LANGUAGE_KEY)
    } catch {}
    if (toBottom) {
      const bottom = () => window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'instant' })
      // As soon as the page is there, and again once its images have their size
      document.addEventListener('DOMContentLoaded', bottom, { once: true })
      window.addEventListener('load', bottom, { once: true })
    }
    document.addEventListener('astro:page-load', () => requestAnimationFrame(() => revealCurrent(true)))
    document.addEventListener('toggle', (event) => {
      if (event.target.id === 'starlight__sidebar' && event.newState === 'open') requestAnimationFrame(() => revealCurrent())
    }, true)
  }
</script>
