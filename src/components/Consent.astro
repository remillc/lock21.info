---
// <l21-consent>: asks once whether the site may measure its audience with Google Analytics (cookies, Québec's Loi 25).
// Nothing is measured before an answer; refusing is as easy as accepting (two buttons of the same weight). The choice
// is kept in localStorage ('l21-consent') and announced with a document event 'l21-consent' (Analytics.astro loads
// Google's script or stops measuring); the footer's "Témoins" button opens the question again. A withdrawn consent also
// deletes Google Analytics' cookies. MD3 motion: enters with emphasized-decelerate (400 ms), leaves with
// emphasized-accelerate (200 ms), instantly with reduced motion. Rendered only when an analytics ID is set.
import { site } from '../data/site'
---

{
  site.analytics.ga4 && (
    <l21-consent hidden>
      <div class="consent-card" role="dialog" aria-label="Mesure d'audience">
        <p>
          Puis-je mesurer la fréquentation du site avec Google Analytics (pages vues, téléchargements, réalité
          augmentée)? Il dépose des témoins (cookies). Rien n'est mesuré sans votre accord.
          <a href="/confidentialite/">En savoir plus</a>
        </p>
        <div class="consent-actions">
          <button type="button" data-consent="denied">Refuser</button>
          <button type="button" data-consent="granted">Accepter</button>
        </div>
      </div>
    </l21-consent>
  )
}

<script>
  const KEY = 'l21-consent'
  const ENTER = { duration: 400, easing: 'cubic-bezier(0.05, 0.7, 0.1, 1)' } // medium4, emphasized-decelerate
  const EXIT = { duration: 200, easing: 'cubic-bezier(0.3, 0, 0.8, 0.15)' } // short4, emphasized-accelerate
  const still = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches

  function stored(): string | null {
    try {
      return localStorage.getItem(KEY)
    } catch {
      return null
    }
  }

  class Consent extends HTMLElement {
    onClick = (event: Event) => {
      const target = event.target as Element | null
      const answer = target?.closest?.('[data-consent]')?.getAttribute('data-consent')
      if (answer && this.contains(target)) return this.answer(answer)
      if (target?.closest?.('[data-consent-open]')) this.open()
    }

    connectedCallback() {
      document.addEventListener('click', this.onClick)
      if (!stored()) this.open()
    }

    disconnectedCallback() {
      document.removeEventListener('click', this.onClick)
    }

    open() {
      if (!this.hidden) return
      this.hidden = false
      if (!still()) this.querySelector('.consent-card')?.animate([{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'none' }], ENTER)
    }

    answer(value: string) {
      try {
        localStorage.setItem(KEY, value)
      } catch {
        // Storage unavailable: the answer lasts until the page is closed
      }
      if (value === 'denied') {
        // Google Analytics' cookies (_ga, _ga_<id>), on this host and on the domain
        for (const name of document.cookie.split(';').map((c) => c.split('=')[0].trim()).filter((n) => n.startsWith('_ga'))) {
          for (const domain of ['', `; domain=.${location.hostname}`]) document.cookie = `${name}=; Max-Age=0; path=/${domain}`
        }
      }
      document.dispatchEvent(new CustomEvent('l21-consent', { detail: value }))
      const card = this.querySelector('.consent-card')
      if (still() || !card) {
        this.hidden = true
        return
      }
      card.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(16px)' }], EXIT).onfinish = () => {
        this.hidden = true
      }
    }
  }
  if (!customElements.get('l21-consent')) customElements.define('l21-consent', Consent)
</script>

<style>
  l21-consent {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 0 1rem max(1rem, env(safe-area-inset-bottom));
    pointer-events: none;
  }
  l21-consent[hidden] {
    display: none;
  }
  .consent-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    max-width: 44rem;
    padding: 1rem 1.25rem;
    border: 2px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-large);
    background: var(--md-sys-color-surface-container-high, var(--md-sys-color-surface-container));
    color: var(--md-sys-color-on-surface);
    box-shadow: 0 6px 24px rgb(0 0 0 / 25%);
    pointer-events: auto;
  }
  .consent-card p {
    flex: 1 1 20rem;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  .consent-card a {
    color: var(--md-sys-color-secondary);
  }
  .consent-actions {
    display: flex;
    gap: 0.75rem;
  }
  /* Two buttons of the same weight (MD3 outlined): refusing as easy as accepting */
  .consent-actions button {
    min-height: 48px;
    padding: 0 1.25rem;
    border: 2px solid var(--md-sys-color-primary);
    border-radius: var(--md-sys-shape-medium);
    background: transparent;
    color: var(--md-sys-color-primary);
    font-family: var(--lk-font-data);
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
  }
  .consent-actions button:hover {
    box-shadow: inset 0 0 0 100px color-mix(in srgb, currentColor 8%, transparent);
  }
  .consent-actions button:focus-visible {
    outline: 2px solid var(--md-sys-color-secondary);
    outline-offset: 2px;
  }
</style>
