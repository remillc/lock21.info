---
// Dive log table: adds a footer row with the number of dives and the total dive time (sum of column 5, "Durée
// (minutes)"), computed at build time, so no JavaScript is shipped. Column 5 must stay a plain number of minutes.
// Usage in MDX: <DiveLog> + the Markdown table + </DiveLog>
import { locale, pageLang } from '../lib/i18n'
import { m } from '../paraglide/messages.js'

const html = await Astro.slots.render('default')
const rows = html.match(/<tbody>[\s\S]*?<\/tbody>/)?.[0].match(/<tr>[\s\S]*?<\/tr>/g) ?? []
const minutes = rows
  .map((row) => row.match(/<td[^>]*>([\s\S]*?)<\/td>/g)?.[4] ?? '')
  .map((cell) => parseFloat(cell.replace(/<[^>]+>/g, '')))
  .filter(Number.isFinite)
  .reduce((sum, m) => sum + m, 0)

const lang = pageLang(Astro.locals)
const duration = { days: Math.floor(minutes / 1440), hours: Math.floor((minutes % 1440) / 60), minutes: Math.round(minutes % 60) }
const total = 'DurationFormat' in Intl
  ? new Intl.DurationFormat(locale(lang), { style: 'long' }).format(duration)
  : `${duration.days} ${m.site_days({}, { locale: lang })} ${duration.hours} h ${duration.minutes} min`
// One row per dive (as the home page counts them, src/lib/diveLog.js). The label takes the four columns before the
// duration, the duration the rest (Durée, Participants, Notes), so it stays on one line
const columns = (html.match(/<thead>[\s\S]*?<\/thead>/)?.[0].match(/<th[\s>]/g) ?? []).length
const label = m.divelog_total({ n: rows.length }, { locale: lang })
const footer = `<tfoot><tr><td colspan="4">${label}</td><td colspan="${columns - 4}">${total}</td></tr></tfoot>`
const withFooter = html.replace('</table>', `${footer}</table>`)
---

<div class="dive-log" set:html={withFooter} />

<style lang="scss">
  @layer l21.components {
    // The table fits the content column: fixed widths for the short columns, Notes takes the rest and wraps
    .dive-log :global(table) {
      display: table; // the global rule makes tables scrollable blocks; this one must fit instead
      width: 100%;
      table-layout: fixed;
      font-size: 0.8125rem;
    }
    .dive-log :global(th),
    .dive-log :global(td) {
      padding: 0.4rem 0.5rem;
    }
    .dive-log :global(td) {
      overflow-wrap: anywhere;
    }
    // No, Date, Activité, Zones, Durée, Participants; Notes (7th) gets the remaining width
    $widths: 3rem, 6.5rem, 6rem, 4.5rem, 6rem, 9rem;
    @for $i from 1 through length($widths) {
      .dive-log :global(th:nth-child(#{$i})) {
        width: nth($widths, $i);
      }
    }
    .dive-log :global(td:nth-child(2)) {
      white-space: nowrap;
    }
    .dive-log :global(tfoot td) {
      font-weight: 600;
    }
    // The header row stays in view under the header bar (and the phone's « Sur cette page » bar) while the long table
    // scrolls with the page. Not on phones: there the table scrolls sideways in its own box, and a header can only
    // stick inside that box
    @media (min-width: 50rem) {
      .dive-log :global(thead th) {
        position: sticky;
        top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
        z-index: 1;
      }
    }
    // Phones: the columns can't fit, the table scrolls sideways with Notes at a readable width
    @media (max-width: 50rem) {
      .dive-log {
        overflow-x: auto;
      }
      .dive-log :global(table) {
        width: 52rem;
      }
      .dive-log :global(th),
      .dive-log :global(td) {
        overflow-wrap: normal;
      }
    }
  }
</style>
