---
import { Icon } from 'astro-icon/components'
// The /modele page, in the spirit of a Sketchfab page: the 3D viewer embedded in a large frame (its own button
// goes full screen), then the model's information, how to navigate, the licence and the downloads. The viewer is a
// separate app (viewer/), published at /modele/viewer; the page doesn't link to that address, visitors only see /modele.
// French at /modele, English at /en/modele (src/lib/i18n.js): the texts are messages (messages/site/, model_…). The viewer itself
// (/modele/viewer) is the same for both.
import QRCode from 'qrcode'
import { site } from '../../data/site'
import { localPath, locale, pageLang } from '../../lib/i18n'
import { m } from '../../paraglide/messages.js'
import { zonesOnline } from '../../lib/manifest'

const lang = pageLang(Astro.locals)
// Every message in the page's language (messages/site/)
const o = { locale: lang }
const en = lang === 'en'
/** A number with the page language's decimal mark (Google Earth Web in French shows a comma) @param {string} n */
const decimal = (n) => (en ? n : n.replace('.', ','))
/** A count in the page's language: 700 000 / 700,000, and whole millions in words, 2 millions / 2 million @param {number} n */
const count = (n) =>
  n >= 1e6 && n % 1e5 === 0
    ? new Intl.NumberFormat(locale(lang), { notation: 'compact', compactDisplay: 'long' }).format(n)
    : n.toLocaleString(locale(lang))
// The viewer's buttons, by their own icons: Material Symbols Rounded names (astro-icon, astro.config.mjs; the viewer
// uses the same names, viewer/src/icons.js)
const ICONS = {
  home: 'home-outline-rounded',
  underwater: 'scuba-diving-rounded',
  tour: 'tour-outline-rounded',
  help: 'help-outline-rounded',
  ar: 'view-in-ar-outline-rounded',
}
// Quotation marks in the page's language: “…” in English, « … » in French
const [open, close] = en ? ['“', '”'] : ['« ', ' »']
const pagePath = localPath(site.viewer, lang)
// The navigation table and the buttons' list: the texts are messages (model_…), the mouse part and the keys data
const gestures = [
  [m.model_gestureTurn({}, o), 'left', m.model_gestureTurnMouse({}, o), m.model_gestureTurnFingers({}, o)],
  [m.model_gesturePan({}, o), 'right', m.model_gesturePanMouse({}, o), m.model_gesturePanFingers({}, o)],
  [m.model_gestureZoom({}, o), 'wheel', m.model_gestureZoomMouse({}, o), m.model_gestureZoomFingers({}, o)],
  [m.model_gestureFly({}, o), 'left', m.model_gestureFlyMouse({}, o), m.model_gestureFlyFingers({}, o)],
]
const moveKeys = [
  [m.model_keyForward({}, o), ['W', '↑']],
  [m.model_keyBack({}, o), ['S', '↓']],
  [m.model_keyLeft({}, o), ['A', '←']],
  [m.model_keyRight({}, o), ['D', '→']],
  [m.model_keyFaster({}, o), [m.model_keyShift({}, o)]],
]
const buttons = [
  ['home', m.model_buttonHome({}, o)],
  ['underwater', m.model_buttonUnderwater({}, o)],
  ['tour', m.model_buttonTour({}, o)],
  ['ar', m.model_buttonAr({}, o), 'coarse'],
  ['help', m.model_buttonHelp({}, o), 'coarse'],
]

const zones = await zonesOnline()
const viewer = `${site.viewer}/viewer`
// QR codes of this page's public address, one per augmented reality size (?ar=full: real size, read by the viewer);
// SVG, dark on white so they scan in both themes
const qrOptions = /** @type {const} */ ({ type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#22251b', light: '#ffffff' } })
const page = new URL(pagePath, Astro.site).href
// utm_*: each code is a Google Analytics campaign (Acquisition reports), read before the page cleans its address
/** @param {string} name */
const campaign = (name) => `utm_source=qr&utm_medium=qr&utm_campaign=${name}`
const qrTable = await QRCode.toString(`${page}?${campaign('ra-table')}`, qrOptions)
const qrFull = await QRCode.toString(`${page}?ar=full&${campaign('ra-taille-reelle')}`, qrOptions)
const updated = zones.updated
  ? new Date(`${zones.updated}T12:00:00`).toLocaleDateString(locale(lang), { day: 'numeric', month: 'long', year: 'numeric' })
  : null
---

<div class="model-page not-content">
  <l21-model-frame class="frame">
    <iframe
      id="viewer-frame"
      title={m.model_frame({}, o)}
      data-src={viewer}
      allow="fullscreen; xr-spatial-tracking"
      loading="eager"></iframe>
  </l21-model-frame>

  <div class="under-frame">
    <div class="heading">
      <h1 id="_top">{m.model_title({}, o)}</h1>
      <p class="byline">{m.model_byline({}, o)}</p>
    </div>
  </div>

  <ul class="chips" aria-label={m.model_brief({}, o)}>
    <li><span>{m.model_online({}, o)}</span>{zones.count} / {site.zonesTotal}</li>
    <li><span>{m.model_latest({}, o)}</span>Z{zones.latest}</li>
    {updated && <li><span>{m.model_updated({}, o)}</span>{updated}</li>}
    <li><span>{m.model_depth({}, o)}</span>{site.bottomDepthFt} {m.site_feet({}, o)} ({site.bottomDepthM.toLocaleString(locale(lang))} m)</li>
    <li><span>{m.model_licence({}, o)}</span>CC BY 4.0</li>
  </ul>

  <div class="columns">
    <!-- First column: the model, then its licence -->
    <div class="stack">
      <section>
        <h2>{m.model_modelTitle({}, o)}</h2>
        <p>{m.model_model1({}, o)}</p>
        <p>{m.model_model2({}, o)}</p>
      </section>
      <section>
        <h2>{m.model_licenceTitle({}, o)}</h2>
        <p>
          {m.model_licenceText({}, o)} <a href={`https://creativecommons.org/licenses/by/4.0/deed.${lang}`}>CC BY 4.0</a>:{' '}
          {m.model_licenceRest({}, o)}
        </p>
        <p class="credit">{m.model_credit({}, o)}</p>
        <!-- The crayfish model (viewer/src/crawfish.js): CC BY 4.0, its author credited -->
        <p class="note">
          {m.model_crayfish({}, o)} {open}<a href="https://sketchfab.com/3d-models/crayfish-cdc4cfc6203443a490f6b5103e7eac18">Crayfish</a>{close}{' '}
          {m.model_crayfishBy({}, o)} <a href="https://sketchfab.com/ucdavisterc">ucdavisterc</a>,{' '}
          <a href={`https://creativecommons.org/licenses/by/4.0/deed.${lang}`}>CC BY 4.0</a>.
        </p>
        <!-- The bass (viewer/src/bass.js): CC BY 4.0, its author credited -->
        <p class="note">
          {m.model_bass({}, o)} {open}<a href="https://sketchfab.com/3d-models/smallmouth-bass-015389aed3414793b3e9e4a0c25169d1">Smallmouth bass</a>{close}{' '}
          {m.model_crayfishBy({}, o)} <a href="https://sketchfab.com/faerbogdan99">faerbogdan99</a>,{' '}
          <a href={`https://creativecommons.org/licenses/by/4.0/deed.${lang}`}>CC BY 4.0</a>.
        </p>
        <!-- The diver's arm (viewer/src/diver-arm.js): its shape from a CC BY 4.0 model, its author credited -->
        <p class="note">
          {m.model_arm({}, o)} {open}<a href="https://sketchfab.com/3d-models/first-person-hands-rigged-547a45535f0c4fe787948f7a7a6a88db">First Person hands rigged</a>{close}{' '}
          {m.model_crayfishBy({}, o)} <a href="https://sketchfab.com/davidfischer">DavidFischer</a>,{' '}
          <a href={`https://creativecommons.org/licenses/by/4.0/deed.${lang}`}>CC BY 4.0</a>.
        </p>
        <p class="note">
          {m.model_drawings({}, o)}{' '}
          <a href="https://saveontarioshipwrecks.ca/chapter-ottawa/">Save Ontario Shipwrecks</a>.
        </p>
      </section>
    </div>

    <section>
      <h2>{m.model_navigate({}, o)}</h2>
      <!-- Short, and only the visitor's own controls (Christian, 2026-10-26: too much text): the mouse column on a
           computer, the fingers on a phone or tablet (the pointer: .fine / .coarse); the keys as key caps; the
           viewer's buttons by their icons. The swimming's details are in the viewer's swim help -->
      <table class="gestures">
        <thead>
          <tr><th scope="col"><span class="sr-only">{m.model_action({}, o)}</span></th><th scope="col" class="fine">{m.model_mouse({}, o)}</th><th scope="col" class="coarse">{m.model_fingers({}, o)}</th></tr>
        </thead>
        <tbody>
          {gestures.map(([action, part, mouse, fingers]) => (
            <tr>
              <th scope="row">{action}</th>
              <td class="fine">
                <!-- A small mouse, the part used in the signal colour (Christian, 2026-10-26: draft B) -->
                <span class="mouse-how">
                  <svg class="mouse" aria-hidden="true" width="28" height="40" viewBox="0 0 28 40">
                    <path class="mouse-body" d="M2 10 Q2 2 14 2 Q26 2 26 10 L26 28 Q26 38 14 38 Q2 38 2 28 Z" />
                    <path class={part === 'left' ? 'mouse-used' : 'mouse-idle'} d="M2 10 Q2 2 13 2 L13 18 L2 18 Z" />
                    <path class={part === 'right' ? 'mouse-used' : 'mouse-idle'} d="M15 2 Q26 2 26 10 L26 18 L15 18 Z" />
                    <rect class={part === 'wheel' ? 'mouse-used' : 'mouse-body'} x="11" y="5" width="6" height="10" rx="3" />
                  </svg>
                  {mouse}
                </span>
              </td>
              <td class="coarse">{fingers}</td>
            </tr>
          ))}
          <!-- The keys, in the table, one move a row, its letter and its arrow (Christian, 2026-10-26): the mouse's
               column, a computer only -->
          {moveKeys.map(([action, keys]) => (
            <tr class="fine">
              <th scope="row">{action}</th>
              <td>{keys.map((key, i) => (<>{i > 0 && ` ${m.model_keysOr({}, o)} `}<kbd>{key}</kbd></>))}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <ul class="buttons">
        {buttons.map(([icon, label, only]) => (
          <li class={only}>
            <span class="icon"><Icon name={`material-symbols:${ICONS[icon]}`} aria-hidden="true" width="24" height="24" /></span>
            {label}
          </li>
        ))}
      </ul>
    </section>

    <div class="stack">
      <section>
        <h2>{m.model_downloads({}, o)}</h2>
        <ul class="downloads">
          <li>
            <!-- download: Astro's router (ClientRouter) leaves the link to the browser instead of loading it as a page -->
            <a class="download" href={site.downloads.kmz} download data-astro-prefetch="false" data-track-download>
              <!-- Material Symbols Rounded « public » -->
              <Icon name="material-symbols:public-outline-rounded" aria-hidden="true" width="18" height="18" />
              Google Earth Pro <span>KMZ</span>
            </a>
            <p>
              {m.model_kmzText({ n: count(site.downloads.kmzTriangles) }, o)}
            </p>
          </li>
          <li>
            <a class="download" href={site.downloads.glb} download data-track-download>
              <!-- Material Symbols Rounded « download » -->
              <Icon name="material-symbols:download-rounded" aria-hidden="true" width="18" height="18" />
              {m.model_glbName({}, o)} <span>GLB · {m.model_glbSize({ n: site.downloads.glbMegabytes }, o)}</span>
            </a>
            <p>
              {m.model_glbText({ n: count(site.downloads.glbTriangles) }, o)} {m.model_glbFresh({}, o)}
            </p>
            {/* The model already in place first, with nothing to download, then how to place the GLB (usability audit V27) */}
            <p>
              {m.model_gewView({}, o)}{' '}<a href={site.downloads.googleEarthWeb} target="_blank" rel="noopener">Google Earth Web</a>.
            </p>
            <!-- Google Earth Web reads no position in a GLB (Christian, 2026-10-26): it is placed by hand. Its panel's labels as
                 Christian saw them, in each language; its numbers with the language's decimal mark (French: a comma).
                 The model's origin is the site anchor, its height that of the KMZ (make_kmz.py: about 4 m); its heading
                 the KMZ's -30 turned 180° about the vertical, 150 (Christian, 2026-10-26: Google Earth Web takes the
                 GLB's other forward axis) -->
            <details class="gew">
              <summary>
                {m.model_gewTitle({}, o)}
                <!-- Material Symbols Rounded « expand_more », 24 dp: turns over as it opens -->
                <Icon name="material-symbols:expand-more-rounded" aria-hidden="true" width="24" height="24" />
              </summary>
              <ol>
                <li>{m.model_gewImport({}, o)}</li>
                <li>
                  {m.model_gewPlace({}, o)}
                  <dl>
                    <dt>{m.model_gewLat({}, o)}</dt><dd><code>{decimal(site.coordinates.lat.toFixed(6))}</code></dd>
                    <dt>{m.model_gewLon({}, o)}</dt><dd><code>{decimal(site.coordinates.lon.toFixed(6))}</code></dd>
                    <dt>{m.model_gewAltitude({}, o)}</dt><dd><code>4</code> m</dd>
                    <dt>{m.model_gewGrounding({}, o)}</dt><dd>{m.model_gewRelative({}, o)}</dd>
                  </dl>
                </li>
                <li>
                  {m.model_gewTurn({}, o)}
                  <dl>
                    <dt>{m.model_gewHeading({}, o)}</dt><dd><code>150</code>°</dd>
                  </dl>
                </li>
              </ol>
            </details>
          </li>
        </ul>
      </section>

      <section>
        <h2>{m.model_arTitle({}, o)}</h2>
        <p>
          {m.model_arText({}, o)}
        </p>
        <!-- Computers: a QR code per size, to open the page on a phone (made at build time) -->
        <div class="qr-codes">
          <figure>
            <div class="qr" set:html={qrTable} />
            <figcaption>{m.model_table({}, o)} <span>1:100</span></figcaption>
          </figure>
          <figure>
            <div class="qr" set:html={qrFull} />
            <figcaption>{m.model_full({}, o)} <span>70 m</span></figcaption>
          </figure>
        </div>
        <!-- Phones: the viewer's button; ?ar=full reaches the viewer through the page's address (full reload) -->
        <p class="ar-on-phone">
          {/* {' '}: the spaces around the links, which the line breaks alone lost (usability audit V28) */}
          {m.model_arPhone({}, o)}{' '}<a href={pagePath} data-astro-reload>{m.model_arTable({}, o)}</a>{' · '}<a
            href={`${pagePath}?ar=full`} data-astro-reload>{m.model_arFull({}, o)}</a>.
        </p>
      </section>
    </div>
  </div>
</div>

<script>
  // <l21-model-frame>: the viewer's iframe. The page's own query string (?cam=…, plus test settings) goes to the
  // viewer, and the viewer's camera comes back into the page's address, so that the page URL always shares the current
  // view. The address keeps only the view's shareable part: ?cam=, and while underwater &underwater=1&season= (&lamp=0).
  // A Custom Element (docs/guidelines.md): set up each time it is inserted, on a full
  // load as after a client-side navigation (ClientRouter, Head.astro), where a plain page script would run only once.
  // replaceState keeps history.state: the router stores its own entry there (back and forward buttons).
  // Settings: kept when the page reloads (the viewer saves them, config-panel.js); forgotten when the visitor arrives
  // from elsewhere (a link, the router's navigation, the address bar, back and forward): the viewer then starts from
  // its defaults (?reset=1). Christian, 2026-10-23
  // A drag in the viewer with the right or middle button, released outside its frame (TODO #70): the page's context
  // menu opened. The viewer says when such a drag starts and ends (lock21:drag); meanwhile, and for DRAG_AFTER ms
  // after (the menu comes with the release, before the viewer's message), the page's context menu is held back
  const DRAG_AFTER = 500
  // Analytics (TODO #88): the time the viewer is seen in each mode, standard or underwater (lock21:mode from the viewer),
  // counted while the page is visible and sent as viewer_end (seconds per mode) when it is hidden or left; a visit hidden
  // and seen again sends one viewer_end each time (sum them per session). Analytics.astro sends it, unless refused
  let connectedBefore = false
  class ModelFrame extends HTMLElement {
    dragging = false
    dragEnd = 0
    underwater = false
    since = 0
    seconds = { standard: 0, underwater: 0 }

    /** The time since `since` added to the current mode */
    count() {
      if (this.since) this.seconds[this.underwater ? 'underwater' : 'standard'] += (performance.now() - this.since) / 1000
      this.since = document.visibilityState === 'visible' ? performance.now() : 0
    }

    sendTime() {
      this.count()
      const standard = Math.round(this.seconds.standard)
      const underwater = Math.round(this.seconds.underwater)
      this.seconds = { standard: 0, underwater: 0 }
      if (standard + underwater < 1) return
      document.dispatchEvent(new CustomEvent('l21:track', { detail: { name: 'viewer_end', params: { standard_seconds: standard, underwater_seconds: underwater } } }))
    }

    onVisibility = () => {
      if (document.visibilityState === 'hidden') this.sendTime()
      else this.since = performance.now()
    }
    /** @param {MouseEvent} event */
    onContextMenu = (event) => {
      if (this.dragging || performance.now() < this.dragEnd) event.preventDefault()
    }

    /** @param {MessageEvent} event */
    onMessage = (event) => {
      const frame = this.querySelector('iframe')
      if (event.origin !== location.origin || event.source !== frame?.contentWindow) return
      if (event.data?.type === 'lock21:mode') {
        this.count()
        this.underwater = Boolean(event.data.underwater)
        return
      }
      if (event.data?.type === 'lock21:drag') {
        this.dragging = Boolean(event.data.on)
        if (!this.dragging) this.dragEnd = performance.now() + DRAG_AFTER
        return
      }
      if (event.data?.type === 'lock21:cam' && typeof event.data.search === 'string') {
        // (and the tour's step, a debugging setting of the viewer: #tour-3, or none)
        history.replaceState(history.state, '', location.pathname + event.data.search + (typeof event.data.hash === 'string' ? event.data.hash : ''))
      }
    }

    connectedCallback() {
      const frame = /** @type {HTMLIFrameElement} */ (this.querySelector('iframe'))
      const reload = !connectedBefore && /** @type {PerformanceNavigationTiming | undefined} */ (performance.getEntriesByType('navigation')[0])?.type === 'reload'
      connectedBefore = true
      // (and the tour's step, #tour-3: kept through a reload, Christian, 2026-10-24)
      const tourHash = /^#tour-\d+$/.test(location.hash) ? location.hash : ''
      frame.src = (frame.dataset.src ?? '') + location.search + (reload ? '' : `${location.search ? '&' : '?'}reset=1`) + tourHash
      const query = new URLSearchParams(location.search)
      const underwater = query.get('underwater') === '1'
      const shared = [...query].filter(([key]) => key === 'cam' || (underwater && ['underwater', 'season', 'lamp'].includes(key)))
      const search = shared.map(([key, value]) => `${key}=${value}`).join('&')
      history.replaceState(history.state, '', location.pathname + (search ? `?${search}` : ''))
      window.addEventListener('message', this.onMessage)
      window.addEventListener('contextmenu', this.onContextMenu, true)
      this.underwater = false
      this.since = document.visibilityState === 'visible' ? performance.now() : 0
      document.addEventListener('visibilitychange', this.onVisibility)
    }

    disconnectedCallback() {
      this.sendTime()
      document.removeEventListener('visibilitychange', this.onVisibility)
      window.removeEventListener('message', this.onMessage)
      window.removeEventListener('contextmenu', this.onContextMenu, true)
    }
  }
  customElements.define('l21-model-frame', ModelFrame)
</script>

<style>
  @layer l21.components {
    .model-page {
      padding-block: 0.5rem 3rem;
      color: var(--md-sys-color-on-surface);
    }

    .frame {
      /* Wider than the text column (1200 px): up to 1600 px, or the window minus a 24 px margin on each side, centred
         on the column (the title and the text below keep the column's width) */
      --frame-width: min(100rem, 100vw - 3rem);
      display: block;
      aspect-ratio: 16 / 9;
      max-height: calc(100vh - var(--sl-nav-height) - 8rem);
      min-height: 20rem;
      width: max(100%, var(--frame-width));
      margin-inline: min(0px, (100% - var(--frame-width)) / 2);
      border: 2px solid var(--md-sys-color-outline);
      border-radius: var(--md-sys-shape-extra-large);
      overflow: hidden;
      background: var(--l21-panel);
    }
    iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .under-frame {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.5rem 1.5rem;
      margin-top: 1.5rem;
    }
    h1 {
      margin: 0;
      font-size: clamp(1.75rem, 3.5vw, 2.25rem);
      line-height: 1.2;
      font-weight: 800;
      color: var(--md-sys-color-on-surface);
    }
    .byline {
      margin: 0.25rem 0 0;
      font-family: var(--l21-font-data);
      font-size: 0.8125rem;
      color: var(--md-sys-color-on-surface-variant);
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 1.25rem 0 0;
      padding: 0;
      list-style: none;
    }
    .chips li {
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0.5rem 0.875rem;
      border: 2px solid var(--md-sys-color-outline);
      border-radius: var(--md-sys-shape-medium);
      background: var(--md-sys-color-surface-container-lowest);
      font-family: var(--l21-font-data);
      font-size: 0.9375rem;
      font-weight: 700;
    }
    :global(:root:not([data-theme='light'])) .chips li {
      background: var(--md-sys-color-surface-container);
    }
    .chips span {
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.03em;
      color: var(--md-sys-color-on-surface-variant);
    }

    .columns {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      gap: 2rem;
      margin-top: 2.5rem;
    }
    .stack {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    h2 {
      margin: 0 0 0.75rem;
      font-size: 1.375rem;
      font-weight: 800;
      color: var(--md-sys-color-on-surface);
    }
    section p {
      margin: 0 0 0.75rem;
      color: var(--md-sys-color-on-surface-variant);
    }
    section a {
      color: var(--md-sys-color-secondary);
    }
    /* Navigating: a short table (the action, then the visitor's column), key caps, the buttons by their icons */
    .gestures {
      border-collapse: collapse;
      margin: 0 0 1.25rem;
      font-size: 0.9375rem;
    }
    .gestures th,
    .gestures td {
      padding: 0.375rem 1.5rem 0.375rem 0;
      border: 0;
      background: none;
      /* The site's table headers are light text on the dark bar (custom.scss): here, no bar, the page's text */
      color: var(--md-sys-color-on-surface);
      text-align: left;
      vertical-align: middle;
    }
    .gestures thead th {
      font-family: var(--l21-font-data);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.03rem;
      text-transform: uppercase;
    }
    /* The first column away from the table's outline, as every column of the site's tables (docs/system-design.md) */
    .gestures tr > :first-child {
      padding-left: 1rem;
    }
    .gestures tbody th {
      font-weight: 600;
    }
    .gestures tbody td {
      color: var(--md-sys-color-on-surface-variant);
    }
    /* (more specific than the site's table cells, custom.scss) */
    table.gestures th,
    table.gestures td {
      vertical-align: middle;
    }
    .mouse-how {
      vertical-align: middle;
      display: inline-flex;
