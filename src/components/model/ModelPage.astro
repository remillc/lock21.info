---
// The /modele page, in the spirit of a Sketchfab page: the 3D viewer embedded in a large frame (its own button
// goes full screen), then the model's information, how to navigate, the licence and the downloads. The viewer is a
// separate app (viewer/), published at /modele/viewer; the page doesn't link to that address, visitors only see /modele.
// French at /modele, English at /en/modele (src/lib/i18n.js): the text below in both languages. The viewer itself
// (/modele/viewer) is the same for both.
import QRCode from 'qrcode'
import { site } from '../../data/site'
import { localPath, locale, pageLang } from '../../lib/i18n'
import { zonesOnline } from '../../lib/manifest'

const lang = pageLang(Astro.locals)
const en = lang === 'en'
/** A number with the page language's decimal mark (Google Earth Web in French shows a comma) @param {string} n */
const decimal = (n) => (en ? n : n.replace('.', ','))
// The viewer's buttons, by their own icons (viewer/index.html: Material Symbols paths, 960 units)
const ICONS = {
  home: 'M240-200h120v-240h240v240h120v-360L480-740 240-560v360Zm-80 80v-480l320-240 320 240v480H520v-240h-80v240H160Zm320-350Z',
  underwater: 'M160-40 96-88l114-152 31-178q3-24 19-42.5t41-24.5l379-115 80-160 120-120 40 40-100 116-60 184-200 140-234 74-46 126L160-40Zm-40-320q-33 0-56.5-23.5T40-440q0-33 23.5-56.5T120-520q33 0 56.5 23.5T200-440q0 33-23.5 56.5T120-360Zm236-196q-24 7-45.5-5.5T282-598q-7-24 5.5-46t36.5-28l182-48 31 116-181 48Z',
  tour: 'M200-80v-800h80v80h560l-80 200 80 200H280v320h-80Zm80-640v240-240Zm220 200q33 0 56.5-23.5T580-600q0-33-23.5-56.5T500-680q-33 0-56.5 23.5T420-600q0 33 23.5 56.5T500-520Zm-220 40h442l-48-120 48-120H280v240Z',
  help: 'M478-240q21 0 35.5-14.5T528-290q0-21-14.5-35.5T478-340q-21 0-35.5 14.5T428-290q0 21 14.5 35.5T478-240Zm-36-154h74q0-33 7.5-52t42.5-52q26-26 41-49.5t15-56.5q0-56-41-86t-97-30q-57 0-92.5 30T342-618l66 26q5-18 22.5-39t53.5-21q32 0 48 17.5t16 38.5q0 20-12 37.5T506-526q-44 39-54 59t-10 73Zm38 314q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z',
  settings: 'm370-80-16-128q-13-5-24.5-12T307-235l-119 50L78-375l103-78q-1-7-1-13.5v-27q0-6.5 1-13.5L78-585l110-190 119 50q11-8 23-15t24-12l16-128h220l16 128q13 5 24.5 12t22.5 15l119-50 110 190-103 78q1 7 1 13.5v27q0 6.5-2 13.5l103 78-110 190-118-50q-11 8-23 15t-24 12L590-80H370Zm70-80h79l14-106q31-8 57.5-23.5T639-327l99 41 39-68-86-65q5-14 7-29.5t2-31.5q0-16-2-31.5t-7-29.5l86-65-39-68-99 42q-22-23-48.5-38.5T533-694l-13-106h-79l-14 106q-31 8-57.5 23.5T321-633l-99-41-39 68 86 64q-5 15-7 30t-2 32q0 16 2 31t7 30l-86 65 39 68 99-42q22 23 48.5 38.5T427-266l13 106Zm42-180q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Zm-2-140Z',
  ar: 'M440-181 240-296q-19-11-29.5-29T200-365v-230q0-22 10.5-40t29.5-29l200-115q19-11 40-11t40 11l200 115q19 11 29.5 29t10.5 40v230q0 22-10.5 40T720-296L520-181q-19 11-40 11t-40-11Zm0-92v-184l-160-93v185l160 92Zm80 0 160-92v-185l-160 93v184ZM80-680v-120q0-33 23.5-56.5T160-880h120v80H160v120H80ZM280-80H160q-33 0-56.5-23.5T80-160v-120h80v120h120v80Zm400 0v-80h120v-120h80v120q0 33-23.5 56.5T800-80H680Zm120-600v-120H680v-80h120q33 0 56.5 23.5T880-800v120h-80ZM480-526l158-93-158-91-158 91 158 93Zm0 45Zm0-45Zm40 69Zm-80 0Z',
}
// Quotation marks in the page's language: “…” in English, « … » in French
const [open, close] = en ? ['“', '”'] : ['« ', ' »']
const pagePath = localPath(site.viewer, lang)
const t = en
  ? {
      frame: '3D viewer of Lock 21',
      title: '3D model of Lock 21',
      byline: 'Christian Rémillard · underwater photogrammetry',
      brief: 'The model at a glance',
      online: 'Zones online',
      latest: 'Latest zone',
      updated: 'Updated',
      depth: 'Depth',
      ft: 'ft',
      licence: 'License',
      modelTitle: 'The model',
      model1:
        'Lock 21 at Dickinson Landing, under the St. Lawrence since 1958, surveyed zone by zone with underwater photogrammetry. Every zone is assembled into a single model; the zones not yet digitised are added dive after dive. The ground around is modelled, not surveyed.',
      model2: 'Detail loads as you get closer: from afar, a lighter version; up close, the zones\' full texture (up to 16,384 px).',
      licenceTitle: 'License',
      licenceText: 'The model is licensed under',
      licenceRest: 'free to reuse, adapt and share it, commercially too, as long as you credit the source:',
      credit: 'Lock 21, 3D model by Christian Rémillard (lock21.info), CC BY 4.0',
      crayfish: 'The crayfish in the underwater view is based on',
      crayfishBy: 'by',
      arm: 'The diver’s arm is based on',
      bass: 'The smallmouth bass is based on',
      drawings: 'Original drawings of the site: Nick Baets (1988), via',
      navigate: 'Navigating',
      mouse: 'Mouse',
      fingers: 'Fingers',
      gestures: [
        ['Turn', 'left', 'drag', '1 finger'],
        ['Pan', 'right', 'drag', '2 fingers'],
        ['Zoom', 'wheel', 'turn the wheel', 'pinch'],
        ['Fly to a point', 'left', 'double-click', 'double-tap'],
      ],
      moveKeys: [
        ['Forward', ['W', '↑']],
        ['Back', ['S', '↓']],
        ['Left', ['A', '←']],
        ['Right', ['D', '→']],
        ['Faster', ['Shift']],
      ],
      keysOr: 'or',
      buttons: [
        ['home', 'Start view'],
        ['underwater', 'Dive and swim (help opens the first time)'],
        ['tour', 'Guided tour, eight steps'],
        ['ar', 'Augmented reality: the lock on a table', 'coarse'],
        ['help', 'Help with the gestures', 'coarse'],
      ],
      downloads: 'Downloads',
      /** @param {string} n */
      kmzText: (n) =>
        `Opens the lock in its place on the map (${n} triangles). The file only holds a link: the zones load from the site, and the ones added later show up the next time it is opened.`,
      glbName: 'Full model',
      /** @param {string} n */
      glbText: (n) => `Zones and the site's model, ${n} triangles: for Blender, Sketchfab, Windows' 3D Viewer or Google Earth Web's import.`,
      gewTitle: 'Placing it in Google Earth Web',
      gewImport: 'In a project, import the GLB (File, Import).',
      gewPlace: 'In its Placement, type these values as they are (with the point):',
      gewTurn: 'Under Transform, Rotation:',
      gewLat: 'Latitude',
      gewLon: 'Longitude',
      gewAltitude: 'Altitude',
      gewGrounding: 'Grounding',
      gewRelative: 'Relative to ground',
      gewHeading: 'Heading',
      arTitle: 'Augmented reality',
      arText: 'Place the lock in front of you with a phone or a tablet: on a table, at 1:100 (70 cm), or at its real size (70 m), in a large open space.',
      table: 'On a table',
      full: 'Real size',
      arPhone: 'Tap the augmented reality button (the cube, at the bottom right of the model). Model size:',
      arTable: 'on a table',
      arFull: 'real size',
    }
  : {
      frame: "Visualiseur 3D de l'écluse 21",
      title: "Modèle 3D de l'écluse 21",
      byline: 'Christian Rémillard · photogrammétrie sous-marine',
      brief: 'Le modèle en bref',
      online: 'Zones en ligne',
      latest: 'Dernière zone',
      updated: 'Mis à jour',
      depth: 'Profondeur',
      ft: 'pi',
      licence: 'Licence',
      modelTitle: 'Le modèle',
      model1:
        "L'écluse 21 de Dickinson Landing, submergée depuis 1958 dans le Saint-Laurent, relevée zone par zone en photogrammétrie sous-marine. Chaque zone est assemblée dans un seul modèle; les zones pas encore numérisées s'ajoutent au fil des plongées. Le terrain autour est une maquette, pas un relevé.",
      model2: "Le détail se charge à mesure qu'on s'approche: de loin, une version allégée; de près, la texture complète des zones (jusqu'à 16 384 px).",
      licenceTitle: 'Licence',
      licenceText: 'Le modèle est sous licence',
      licenceRest: "libre de le réutiliser, de l'adapter et de le partager, y compris commercialement, en citant la source:",
      credit: 'Écluse 21, modèle 3D par Christian Rémillard (lock21.info), CC BY 4.0',
      crayfish: 'L’écrevisse de la vue sous-marine est tirée de',
      crayfishBy: 'par',
      arm: 'Le bras du plongeur est tiré de',
      bass: 'L’achigan à petite bouche est tiré de',
      drawings: "Dessins d'origine du site: Nick Baets (1988), via",
      navigate: 'Naviguer',
      mouse: 'Souris',
      fingers: 'Doigts',
      gestures: [
        ['Tourner', 'left', 'glisser', '1 doigt'],
        ['Déplacer', 'right', 'glisser', '2 doigts'],
        ['Zoomer', 'wheel', 'tourner la molette', 'pincer'],
        ["S'approcher d'un point", 'left', 'double-clic', 'double-toucher'],
      ],
      moveKeys: [
        ['Avancer', ['W', '↑']],
        ['Reculer', ['S', '↓']],
        ['À gauche', ['A', '←']],
        ['À droite', ['D', '→']],
        ['Plus vite', ['Maj']],
      ],
      keysOr: 'ou',
      buttons: [
        ['home', 'Vue de départ'],
        ['underwater', "Plonger et nager (l'aide s'ouvre la première fois)"],
        ['tour', 'Visite guidée, huit étapes'],
        ['ar', "Réalité augmentée: l'écluse sur une table", 'coarse'],
        ['help', 'Aide sur les gestes', 'coarse'],
      ],
      downloads: 'Téléchargements',
      /** @param {string} n */
      kmzText: (n) =>
        `Ouvre l'écluse à sa place sur la carte (${n} triangles). Le fichier ne contient qu'un lien: les zones sont chargées depuis le site, et celles qui s'ajoutent apparaissent à la prochaine ouverture.`,
      glbName: 'Modèle complet',
      /** @param {string} n */
      glbText: (n) => `Zones et maquette du site, ${n} de triangles: pour Blender, Sketchfab, la visionneuse 3D de Windows ou l'import de Google Earth Web.`,
      gewTitle: 'Le placer dans Google Earth Web',
      gewImport: 'Dans un projet, importez le GLB (Fichier, Importer).',
      gewPlace: 'Dans Emplacement, entrez ces valeurs (avec un point plutôt que la virgule si Google Earth est en anglais):',
      gewTurn: 'Sous Transformation, Rotation:',
      gewLat: 'Latitude',
      gewLon: 'Longitude',
      gewAltitude: 'Altitude',
      gewGrounding: 'Surface de référence',
      gewRelative: 'Par rapport au sol',
      gewHeading: 'Orientation',
      arTitle: 'Réalité augmentée',
      arText: "Posez l'écluse devant vous avec un téléphone ou une tablette: sur une table, au 1:100 (70 cm), ou à sa taille réelle (70 m), dans un grand espace dégagé.",
      table: 'Sur une table',
      full: 'Taille réelle',
      arPhone: 'Touchez le bouton de réalité augmentée (le cube, en bas à droite du modèle). Taille du modèle:',
      arTable: 'sur une table',
      arFull: 'taille réelle',
    }

const zones = await zonesOnline()
const viewer = `${site.viewer}/viewer`
// QR codes of this page's public address, one per augmented reality size (?ar=full: real size, read by the viewer);
// SVG, dark on white so they scan in both themes
const qrOptions = /** @type {const} */ ({ type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#22251b', light: '#ffffff' } })
const page = new URL(pagePath, Astro.site).href
// utm_*: each code is a Google Analytics campaign (Acquisition reports), read before the page cleans its address
/** @param {string} name */
const campaign = (name) => `utm_source=qr&utm_medium=qr&utm_campaign=${name}`
const qrTable = await QRCode.toString(`${page}?${campaign('ra-table')}`, qrOptions)
const qrFull = await QRCode.toString(`${page}?ar=full&${campaign('ra-taille-reelle')}`, qrOptions)
const updated = zones.updated
  ? new Date(`${zones.updated}T12:00:00`).toLocaleDateString(locale(lang), { day: 'numeric', month: 'long', year: 'numeric' })
  : null
---

<div class="model-page not-content">
  <l21-model-frame class="frame">
    <iframe
      id="viewer-frame"
      title={t.frame}
      data-src={viewer}
      allow="fullscreen; xr-spatial-tracking"
      loading="eager"></iframe>
  </l21-model-frame>

  <div class="under-frame">
    <div class="heading">
      <h1 id="_top">{t.title}</h1>
      <p class="byline">{t.byline}</p>
    </div>
  </div>

  <ul class="chips" aria-label={t.brief}>
    <li><span>{t.online}</span>{zones.count} / {site.zonesTotal}</li>
    <li><span>{t.latest}</span>Z{zones.latest}</li>
    {updated && <li><span>{t.updated}</span>{updated}</li>}
    <li><span>{t.depth}</span>{site.bottomDepthFt} {t.ft} ({site.bottomDepthM.toLocaleString(locale(lang))} m)</li>
    <li><span>{t.licence}</span>CC BY 4.0</li>
  </ul>

  <div class="columns">
    <!-- First column: the model, then its licence -->
    <div class="stack">
      <section>
        <h2>{t.modelTitle}</h2>
        <p>{t.model1}</p>
        <p>{t.model2}</p>
      </section>
      <section>
        <h2>{t.licenceTitle}</h2>
        <p>
          {t.licenceText} <a href={`https://creativecommons.org/licenses/by/4.0/deed.${lang}`}>CC BY 4.0</a>:{' '}
          {t.licenceRest}
        </p>
        <p class="credit">{t.credit}</p>
        <!-- The crayfish model (viewer/src/crawfish.js): CC BY 4.0, its author credited -->
        <p class="note">
          {t.crayfish} {open}<a href="https://sketchfab.com/3d-models/crayfish-cdc4cfc6203443a490f6b5103e7eac18">Crayfish</a>{close}{' '}
          {t.crayfishBy} <a href="https://sketchfab.com/ucdavisterc">ucdavisterc</a>,{' '}
          <a href={`https://creativecommons.org/licenses/by/4.0/deed.${lang}`}>CC BY 4.0</a>.
        </p>
        <!-- The bass (viewer/src/bass.js): CC BY 4.0, its author credited -->
        <p class="note">
          {t.bass} {open}<a href="https://sketchfab.com/3d-models/smallmouth-bass-015389aed3414793b3e9e4a0c25169d1">Smallmouth bass</a>{close}{' '}
          {t.crayfishBy} <a href="https://sketchfab.com/faerbogdan99">faerbogdan99</a>,{' '}
          <a href={`https://creativecommons.org/licenses/by/4.0/deed.${lang}`}>CC BY 4.0</a>.
        </p>
        <!-- The diver's arm (viewer/src/diver-arm.js): its shape from a CC BY 4.0 model, its author credited -->
        <p class="note">
          {t.arm} {open}<a href="https://sketchfab.com/3d-models/first-person-hands-rigged-547a45535f0c4fe787948f7a7a6a88db">First Person hands rigged</a>{close}{' '}
          {t.crayfishBy} <a href="https://sketchfab.com/davidfischer">DavidFischer</a>,{' '}
          <a href={`https://creativecommons.org/licenses/by/4.0/deed.${lang}`}>CC BY 4.0</a>.
        </p>
        <p class="note">
          {t.drawings}{' '}
          <a href="https://saveontarioshipwrecks.ca/chapter-ottawa/">Save Ontario Shipwrecks</a>.
        </p>
      </section>
    </div>

    <section>
      <h2>{t.navigate}</h2>
      <!-- Short, and only the visitor's own controls (Christian, 2026-10-26: too much text): the mouse column on a
           computer, the fingers on a phone or tablet (the pointer: .fine / .coarse); the keys as key caps; the
           viewer's buttons by their icons. The swimming's details are in the viewer's swim help -->
      <table class="gestures">
        <thead>
          <tr><th></th><th scope="col" class="fine">{t.mouse}</th><th scope="col" class="coarse">{t.fingers}</th></tr>
        </thead>
        <tbody>
          {t.gestures.map(([action, part, mouse, fingers]) => (
            <tr>
              <th scope="row">{action}</th>
              <td class="fine">
                <!-- A small mouse, the part used in the signal colour (Christian, 2026-10-26: draft B) -->
                <span class="mouse-how">
                  <svg class="mouse" aria-hidden="true" width="28" height="40" viewBox="0 0 28 40">
                    <path class="mouse-body" d="M2 10 Q2 2 14 2 Q26 2 26 10 L26 28 Q26 38 14 38 Q2 38 2 28 Z" />
                    <path class={part === 'left' ? 'mouse-used' : 'mouse-idle'} d="M2 10 Q2 2 13 2 L13 18 L2 18 Z" />
                    <path class={part === 'right' ? 'mouse-used' : 'mouse-idle'} d="M15 2 Q26 2 26 10 L26 18 L15 18 Z" />
                    <rect class={part === 'wheel' ? 'mouse-used' : 'mouse-body'} x="11" y="5" width="6" height="10" rx="3" />
                  </svg>
                  {mouse}
                </span>
              </td>
              <td class="coarse">{fingers}</td>
            </tr>
          ))}
          <!-- The keys, in the table, one move a row, its letter and its arrow (Christian, 2026-10-26): the mouse's
               column, a computer only -->
          {t.moveKeys.map(([action, keys]) => (
            <tr class="fine">
              <th scope="row">{action}</th>
              <td>{keys.map((key, i) => (<>{i > 0 && ` ${t.keysOr} `}<kbd>{key}</kbd></>))}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <ul class="buttons">
        {t.buttons.map(([icon, label, only]) => (
          <li class={only}>
            <span class="icon"><svg aria-hidden="true" width="24" height="24" viewBox="0 -960 960 960" fill="currentColor"><path d={ICONS[icon]} /></svg></span>
            {label}
          </li>
        ))}
      </ul>
    </section>

    <div class="stack">
      <section>
        <h2>{t.downloads}</h2>
        <ul class="downloads">
          <li>
            <!-- download: Astro's router (ClientRouter) leaves the link to the browser instead of loading it as a page -->
            <a class="download" href={site.downloads.kmz} download data-astro-prefetch="false" data-track-download>
              <!-- Material Symbols « public » -->
              <svg aria-hidden="true" width="18" height="18" viewBox="0 -960 960 960" fill="currentColor"><path d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm-40-82v-78q-33 0-56.5-23.5T360-320v-40L168-552q-3 18-5.5 36t-2.5 36q0 121 79.5 212T440-162Zm276-102q20-22 36-47.5t26.5-53q10.5-27.5 16-56.5t5.5-59q0-98-54.5-179T600-776v16q0 33-23.5 56.5T520-680h-80v80q0 17-11.5 28.5T400-560h-80v80h240q17 0 28.5 11.5T600-440v120h40q26 0 47 15.5t29 40.5Z"/></svg>
              Google Earth Pro <span>KMZ</span>
            </a>
            <p>
              {t.kmzText(site.downloads.kmzTriangles)}
            </p>
          </li>
          <li>
            <a class="download" href={site.downloads.glb} download data-track-download>
              <!-- Material Symbols « download » -->
              <svg aria-hidden="true" width="18" height="18" viewBox="0 -960 960 960" fill="currentColor"><path d="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z"/></svg>
              {t.glbName} <span>GLB · {site.downloads.glbSize}</span>
            </a>
            <p>
              {t.glbText(site.downloads.glbTriangles)}
            </p>
            <!-- Google Earth Web reads no position in a GLB (Christian, 2026-10-26): it is placed by hand. Its panel's labels as
                 Christian saw them, in each language; its numbers with the language's decimal mark (French: a comma).
                 The model's origin is the site anchor, its height that of the KMZ (make_kmz.py: about 4 m); its heading
                 the KMZ's -30 turned 180° about the vertical, 150 (Christian, 2026-10-26: Google Earth Web takes the
                 GLB's other forward axis) -->
            <details class="gew">
              <summary>
                {t.gewTitle}
                <!-- Material Symbols Rounded « expand_more », 24 dp: turns over as it opens -->
                <svg aria-hidden="true" width="24" height="24" viewBox="0 -960 960 960" fill="currentColor"><path d="M480-361q-8 0-15-2.5t-13-8.5L268-556q-11-11-11-28t11-28q11-11 28-11t28 11l156 156 156-156q11-11 28-11t28 11q11 11 11 28t-11 28L508-372q-6 6-13 8.5t-15 2.5Z"/></svg>
              </summary>
              <ol>
                <li>{t.gewImport}</li>
                <li>
                  {t.gewPlace}
                  <dl>
                    <dt>{t.gewLat}</dt><dd><code>{decimal(site.coordinates.lat.toFixed(6))}</code></dd>
                    <dt>{t.gewLon}</dt><dd><code>{decimal(site.coordinates.lon.toFixed(6))}</code></dd>
                    <dt>{t.gewAltitude}</dt><dd><code>4</code> m</dd>
                    <dt>{t.gewGrounding}</dt><dd>{t.gewRelative}</dd>
                  </dl>
                </li>
                <li>
                  {t.gewTurn}
                  <dl>
                    <dt>{t.gewHeading}</dt><dd><code>150</code></dd>
                  </dl>
                </li>
              </ol>
            </details>
          </li>
        </ul>
    
      </section>

      <section>
        <h2>{t.arTitle}</h2>
        <p>
          {t.arText}
        </p>
        <!-- Computers: a QR code per size, to open the page on a phone (made at build time) -->
        <div class="qr-codes">
          <figure>
            <div class="qr" set:html={qrTable} />
            <figcaption>{t.table} <span>1:100</span></figcaption>
          </figure>
          <figure>
            <div class="qr" set:html={qrFull} />
            <figcaption>{t.full} <span>70 m</span></figcaption>
          </figure>
        </div>
        <!-- Phones: the viewer's button; ?ar=full reaches the viewer through the page's address (full reload) -->
        <p class="ar-on-phone">
          {t.arPhone}
          <a href={pagePath} data-astro-reload>{t.arTable}</a> ·
          <a href={`${pagePath}?ar=full`} data-astro-reload>{t.arFull}</a>.
        </p>
      </section>
    </div>
  </div>
</div>

<script>
  // <l21-model-frame>: the viewer's iframe. The page's own query string (?cam=…, plus test settings) goes to the
  // viewer, and the viewer's camera comes back into the page's address, so that the page URL always shares the current
  // view. The address keeps only the view's shareable part: ?cam=, and while underwater &underwater=1&season= (&lamp=0).
  // A Custom Element (docs/guidelines.md): set up each time it is inserted, on a full
  // load as after a client-side navigation (ClientRouter, Head.astro), where a plain page script would run only once.
  // replaceState keeps history.state: the router stores its own entry there (back and forward buttons).
  // Settings: kept when the page reloads (the viewer saves them, config-panel.js); forgotten when the visitor arrives
  // from elsewhere (a link, the router's navigation, the address bar, back and forward): the viewer then starts from
  // its defaults (?reset=1). Christian, 2026-10-23
  // A drag in the viewer with the right or middle button, released outside its frame (TODO #70): the page's context
  // menu opened. The viewer says when such a drag starts and ends (lock21:drag); meanwhile, and for DRAG_AFTER ms
  // after (the menu comes with the release, before the viewer's message), the page's context menu is held back
  const DRAG_AFTER = 500
  let connectedBefore = false
  class ModelFrame extends HTMLElement {
    dragging = false
    dragEnd = 0
    /** @param {MouseEvent} event */
    onContextMenu = (event) => {
      if (this.dragging || performance.now() < this.dragEnd) event.preventDefault()
    }

    /** @param {MessageEvent} event */
    onMessage = (event) => {
      const frame = this.querySelector('iframe')
      if (event.origin !== location.origin || event.source !== frame?.contentWindow) return
      if (event.data?.type === 'lock21:drag') {
        this.dragging = Boolean(event.data.on)
        if (!this.dragging) this.dragEnd = performance.now() + DRAG_AFTER
        return
      }
      if (event.data?.type === 'lock21:cam' && typeof event.data.search === 'string') {
        // (and the tour's step, a debugging setting of the viewer: #tour-3, or none)
        history.replaceState(history.state, '', location.pathname + event.data.search + (typeof event.data.hash === 'string' ? event.data.hash : ''))
      }
    }

    connectedCallback() {
      const frame = /** @type {HTMLIFrameElement} */ (this.querySelector('iframe'))
      const reload = !connectedBefore && /** @type {PerformanceNavigationTiming | undefined} */ (performance.getEntriesByType('navigation')[0])?.type === 'reload'
      connectedBefore = true
      // (and the tour's step, #tour-3: kept through a reload, Christian, 2026-10-24)
      const tourHash = /^#tour-\d+$/.test(location.hash) ? location.hash : ''
      frame.src = (frame.dataset.src ?? '') + location.search + (reload ? '' : `${location.search ? '&' : '?'}reset=1`) + tourHash
      const query = new URLSearchParams(location.search)
      const underwater = query.get('underwater') === '1'
      const shared = [...query].filter(([key]) => key === 'cam' || (underwater && ['underwater', 'season', 'lamp'].includes(key)))
      const search = shared.map(([key, value]) => `${key}=${value}`).join('&')
      history.replaceState(history.state, '', location.pathname + (search ? `?${search}` : ''))
      window.addEventListener('message', this.onMessage)
      window.addEventListener('contextmenu', this.onContextMenu, true)
    }

    disconnectedCallback() {
      window.removeEventListener('message', this.onMessage)
      window.removeEventListener('contextmenu', this.onContextMenu, true)
    }
  }
  customElements.define('l21-model-frame', ModelFrame)
</script>

