---
// The /modele/ page, in the spirit of a Sketchfab page: the 3D viewer embedded in a large frame (its own button
// goes full screen), then the model's information, how to navigate, the licence and the downloads. The viewer is a
// separate app (viewer/), published at /modele/viewer/; the page doesn't link to that address, visitors only see /modele/.
import { site } from '../../data/site'
import { zonesOnline } from '../../lib/manifest'

const zones = await zonesOnline()
const viewer = `${site.viewer}viewer/`
const updated = zones.updated
  ? new Date(`${zones.updated}T12:00:00`).toLocaleDateString('fr-CA', { day: 'numeric', month: 'long', year: 'numeric' })
  : null
---

<div class="model-page not-content">
  <l21-model-frame class="frame">
    <iframe
      id="viewer-frame"
      title="Visualiseur 3D de l'écluse 21"
      data-src={viewer}
      allow="fullscreen"
      allowfullscreen
      loading="eager"></iframe>
  </l21-model-frame>

  <div class="under-frame">
    <div class="heading">
      <h1 id="_top">Modèle 3D de l'écluse 21</h1>
      <p class="byline">Christian Rémillard · photogrammétrie sous-marine</p>
    </div>
  </div>

  <ul class="chips" aria-label="Le modèle en bref">
    <li><span>Zones en ligne</span>{zones.count} / {site.zonesTotal}</li>
    <li><span>Dernière zone</span>Z{zones.latest}</li>
    {updated && <li><span>Mis à jour</span>{updated}</li>}
    <li><span>Profondeur</span>{site.bottomDepthFt} pi ({site.bottomDepthM.toLocaleString('fr-CA')} m)</li>
    <li><span>Licence</span>CC BY 4.0</li>
  </ul>

  <div class="columns">
    <section>
      <h2>Le modèle</h2>
      <p>
        L'écluse 21 de Dickinson Landing, submergée depuis 1958 dans le Saint-Laurent, relevée zone par zone en
        photogrammétrie sous-marine. Chaque zone est assemblée dans un seul modèle; les zones pas encore numérisées
        s'ajoutent au fil des plongées. Le terrain autour est une maquette, pas un relevé.
      </p>
      <p>
        Le détail se charge à mesure qu'on s'approche: de loin, une version allégée; de près, la texture complète des
        zones (jusqu'à 16 384 px).
      </p>
    </section>

    <section>
      <h2>Naviguer</h2>
      <dl class="controls">
        <dt>Tourner</dt><dd>glisser avec le bouton gauche · un doigt</dd>
        <dt>Déplacer</dt><dd>glisser avec le bouton droit · deux doigts</dd>
        <dt>Zoomer</dt><dd>molette · pincer</dd>
        <dt>Plein écran</dt><dd>bouton en bas à droite du modèle · Échap pour sortir</dd>
        <dt>Partager une vue</dt><dd>copier l'adresse de la page: elle garde la position de la caméra</dd>
      </dl>
    </section>

    <section>
      <h2>Licence et téléchargements</h2>
      <p>
        Le modèle est sous licence <a href="https://creativecommons.org/licenses/by/4.0/deed.fr">CC BY 4.0</a>:
        libre de le réutiliser, de l'adapter et de le partager, y compris commercialement, en citant la source:
      </p>
      <p class="credit">Écluse 21, modèle 3D par Christian Rémillard (lock21.info), CC BY 4.0</p>
      <ul class="downloads">
        <li>
          <!-- download: Astro's router (ClientRouter) leaves the link to the browser instead of loading it as a page -->
          <a class="download" href={site.downloads.kmz} download data-astro-prefetch="false">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
            Google Earth Pro <span>KMZ</span>
          </a>
          <p>
            Ouvre l'écluse à sa place sur la carte ({site.downloads.kmzTriangles} triangles). Le fichier ne contient qu'un
            lien: les zones sont chargées depuis le site, et celles qui s'ajoutent apparaissent à la prochaine ouverture.
            Posé au sol: Google Earth ne descend pas sous l'eau.
          </p>
        </li>
        <li>
          <a class="download" href={site.downloads.glb} download>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Modèle complet <span>GLB · {site.downloads.glbSize}</span>
          </a>
          <p>
            Zones et maquette du site, {site.downloads.glbTriangles} de triangles: pour Blender, Sketchfab, la visionneuse
            3D de Windows ou l'import de Google Earth Web.
          </p>
        </li>
      </ul>
      <p>
        Dessins d'origine du site: Nick Baets (1988), via{' '}
        <a href="https://saveontarioshipwrecks.ca/chapter-ottawa/">Save Ontario Shipwrecks</a>.
      </p>
    </section>
  </div>
</div>

<script>
  // <l21-model-frame>: the viewer's iframe. The page's own query string (?cam=…, plus test settings) goes to the
  // viewer, and the viewer's camera comes back into the page's address, so that the page URL always shares the current
  // view. The address keeps only ?cam=. A Custom Element (GUIDELINES.md): set up each time it is inserted, on a full
  // load as after a client-side navigation (ClientRouter, Head.astro), where a plain page script would run only once.
  // replaceState keeps history.state: the router stores its own entry there (back and forward buttons).
  class ModelFrame extends HTMLElement {
    onMessage = (event: MessageEvent) => {
      const frame = this.querySelector('iframe')
      if (event.origin !== location.origin || event.source !== frame?.contentWindow) return
      if (event.data?.type === 'lock21:cam' && typeof event.data.search === 'string') {
        history.replaceState(history.state, '', location.pathname + event.data.search)
      }
    }

    connectedCallback() {
      const frame = this.querySelector('iframe') as HTMLIFrameElement
      frame.src = (frame.dataset.src ?? '') + location.search
      const cam = new URLSearchParams(location.search).get('cam')
      history.replaceState(history.state, '', location.pathname + (cam ? `?cam=${cam}` : ''))
      window.addEventListener('message', this.onMessage)
    }

    disconnectedCallback() {
      window.removeEventListener('message', this.onMessage)
    }
  }
  customElements.define('l21-model-frame', ModelFrame)
</script>

<style>
  .model-page {
    padding-block: 0.5rem 3rem;
    color: var(--md-sys-color-on-surface);
  }

  .frame {
    /* Wider than the text column (1200 px): up to 1600 px, or the window minus a 24 px margin on each side, centred
       on the column (the title and the text below keep the column's width) */
    --frame-width: min(100rem, 100vw - 3rem);
    display: block;
    aspect-ratio: 16 / 9;
    max-height: calc(100vh - var(--sl-nav-height) - 8rem);
    min-height: 20rem;
    width: max(100%, var(--frame-width));
    margin-inline: min(0px, (100% - var(--frame-width)) / 2);
    border: 2px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-extra-large);
    overflow: hidden;
    background: #0b1c26;
  }
  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .under-frame {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    line-height: 1.2;
    font-weight: 800;
    color: var(--md-sys-color-on-surface);
  }
  .byline {
    margin: 0.25rem 0 0;
    font-family: var(--lk-font-data);
    font-size: 0.8125rem;
    color: var(--md-sys-color-on-surface-variant);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0.5rem 0.875rem;
    border: 2px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-medium);
    background: var(--md-sys-color-surface-container-lowest);
    font-family: var(--lk-font-data);
    font-size: 0.9375rem;
    font-weight: 700;
  }
  :global(:root:not([data-theme='light'])) .chips li {
    background: var(--md-sys-color-surface-container);
  }
  .chips span {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--md-sys-color-on-surface-variant);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 2rem;
    margin-top: 2.5rem;
  }
  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--md-sys-color-on-surface);
  }
  section p {
    margin: 0 0 0.75rem;
    color: var(--md-sys-color-on-surface-variant);
  }
  section a {
    color: var(--md-sys-color-secondary);
  }
  .controls {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1rem;
    margin: 0;
  }
  .controls dt {
    font-family: var(--lk-font-data);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .controls dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--md-sys-color-on-surface-variant);
  }
  .downloads {
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }
  .downloads li {
    margin: 0 0 0.75rem;
  }
  /* MD3 outlined button with a leading icon, in the primary colour (as the home page's buttons): 48 px touch target,
     label-large */
  .download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0 1.5rem 0 1rem;
    border: 2px solid var(--md-sys-color-primary);
    border-radius: var(--md-sys-shape-medium);
    color: var(--md-sys-color-primary);
    font-family: var(--lk-font-data);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .download:hover {
    box-shadow: inset 0 0 0 100px color-mix(in srgb, currentColor 8%, transparent); /* MD3 hover state layer */
  }
  .download:focus-visible {
    outline: 2px solid var(--md-sys-color-secondary);
    outline-offset: 2px;
  }
  .download span {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--md-sys-color-on-surface-variant);
  }
  .downloads p {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
  }
  .credit {
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--md-sys-color-secondary);
    border-radius: 0 var(--md-sys-shape-small) var(--md-sys-shape-small) 0;
    background: var(--md-sys-color-surface-container);
    font-family: var(--lk-font-data);
    font-size: 0.8125rem;
    color: var(--md-sys-color-on-surface) !important;
  }
</style>
